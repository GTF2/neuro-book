{
    "compilerOptions": {
        "target": "ESNext",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "lib": [
            "ESNext"
        ],
        "types": [
            "node"
        ],
        "strict": true,
        "noEmit": true,
        "skipLibCheck": true,
        "baseUrl": ".",
        "paths": {
            "nbook/*": [
                "./*"
            ]
        }
    },
    "include": [
        "runtime/**/*.ts"
    ]
}
