  "disclosures": [
    {
      "id": "d01",
      "from": 2,
      "to": 2,
      "text": "作者声明：本书出场角色均已满18岁，不存在任何未成年人。",
      "channel": "author",
      "mode": "assertion",
      "holder": null,
      "about": []
    },
    {
      "id": "d02",
      "from": 4,
      "to": 4,
      "text": "未知声音要求提供姓名。",
      "channel": "voice",
      "mode": "request",
      "holder": null,
      "about": []
    },
    {
      "id": "d03",
      "from": 5,
      "to": 5,
      "text": "苏天晴报出自己的姓名：苏天晴。",
      "channel": "speech",
      "mode": "assertion",
      "holder": "r_su",
      "about": [
        "r_su"
      ]
    },
    {
      "id": "d04",
      "from": 6,
      "to": 6,
      "text": "昏暗房间里传出清脆悦耳的女声，以及一道仿佛来自遥远彼方的低沉言语。",
      "channel": "narrator",
      "mode": "assertion",
      "holder": null,
      "about": []
    },
    {
      "id": "d05",
      "from": 7,
      "to": 7,
      "text": "苏天晴坐在床头，呆滞地看着飘浮在半空中的黑色古书，并从落地镜中瞥见一道陌生的娇小身影。",
      "channel": "narrator",
      "mode": "assertion",
      "holder": null,
      "about": [
        "r_su",
        "r_book"
      ]
    },
    {
      "id": "d06",
      "from": 12,
      "to": 12,
      "text": "黑色古书发出低沉言语，表示知道了。",
      "channel": "speech",
      "mode": "assertion",
      "holder": "r_book",
      "about": []
    },
    {
      "id": "d07",
      "from": 14,
      "to": 15,
      "text": "苏天晴回想：五分钟前她结束连续三个夜班下班，在街边面摊吃加煎蛋的牛肉面并加辣椒面，突然听到太奶在背后说话，回头见太奶坐在藤椅上编围巾，随后胸口一疼、眼前一黑失去意识。",
      "channel": "thought",
      "mode": "assertion",
      "holder": "r_su",
      "about": [
        "r_su",
        "r_tanai"
      ]
    },
    {
      "id": "d08",
      "from": 19,
      "to": 19,
      "text": "古书问苏天晴在干嘛。",
      "channel": "speech",
      "mode": "question",
      "holder": "r_book",
      "about": [
        "r_su"
      ]
    },
    {
      "id": "d09",
      "from": 20,
      "to": 20,
      "text": "古书不太明白眼前的狐狐为什么要突然用怪异的手法去薅她自己的尾巴。",
      "channel": "thought",
      "mode": "assertion",
      "holder": "r_book",
      "about": [
        "r_su"
      ]
    },
    {
      "id": "d10",
      "from": 21,
      "to": 21,
      "text": "古书心想：不疼的吗？",
      "channel": "thought",
      "mode": "question",
      "holder": "r_book",
      "about": [
        "r_su"
      ]
    },
    {
      "id": "d11",
      "from": 22,
      "to": 22,
      "text": "苏天晴咳嗽两声掩饰尴尬，要求古书稍等一下。",
      "channel": "speech",
      "mode": "request",
      "holder": "r_su",
      "about": [
        "r_book"
      ]
    },
    {
      "id": "d12",
      "from": 24,
      "to": 24,
      "text": "苏天晴心想：我重生了。",
      "channel": "thought",
      "mode": "assertion",
      "holder": "r_su",
      "about": [
        "r_su"
      ]
    },
    {
      "id": "d13",
      "from": 25,
      "to": 25,
      "text": "苏天晴心想：重生成了一只金毛狐女。",
      "channel": "thought",
      "mode": "assertion",
      "holder": "r_su",
      "about": [
        "r_su"
      ]
    },
    {
      "id": "d14",
      "from": 26,
      "to": 26,
      "text": "苏天晴心想，眼前这本黑色会说话的书是怎么回事，有人能解释一下吗。",
      "channel": "thought",
      "mode": "question",
      "holder": "r_su",
      "about": [
        "r_book"
      ]
    },
    {
      "id": "d15",
      "from": 27,
      "to": 27,
      "text": "苏天晴问古书：你是谁？",
      "channel": "speech",
      "mode": "question",
      "holder": "r_su",
      "about": [
        "r_book"
      ]
    },
    {
      "id": "d16",
      "from": 29,
      "to": 29,
      "text": "古书自称吾名墨丘利秘典，从星空彼岸远行至此，前来寻找最优秀的适格者。",
      "channel": "speech",
      "mode": "assertion",
      "holder": "r_book",
      "about": [
        "r_book"
      ]
    },
    {
      "id": "d17",
      "from": 30,
      "to": 30,
      "text": "古书说它寻找的人就是苏天晴小姐。",
      "channel": "speech",
      "mode": "assertion",
      "holder": "r_book",
      "about": [
        "r_su"
      ]
    },
    {
      "id": "d18",
      "from": 34,
      "to": 34,
      "text": "苏天晴心想：完美，绝品。",
      "channel": "thought",
      "mode": "assertion",
      "holder": "r_su",
      "about": []
    },
    {
      "id": "d19",
      "from": 35,
      "to": 35,
      "text": "古书说看来苏天晴对现在的身体很满意。",
      "channel": "speech",
      "mode": "assertion",
      "holder": "r_book",
      "about": [
        "r_su"
      ]
    },
    {
      "id": "d20",
      "from": 37,
      "to": 37,
      "text": "古书问苏天晴为什么盯着脚看，并说正常情况下不应该是这样。",
      "channel": "speech",
      "mode": "question",
      "holder": "r_book",
      "about": [
        "r_su"
      ]
    },
    {
      "id": "d21",
      "from": 38,
      "to": 38,
      "text": "苏天晴对古书说，小脚是世界上最美好的瑰宝，吃饭时看见都能多炫两碗。",
      "channel": "speech",
      "mode": "assertion",
      "holder": "r_su",
      "about": [
        "r_book"
      ]
    },
    {
      "id": "d22",
      "from": 40,
      "to": 40,
      "text": "苏天晴心想，这本书知道自己并不是这副身体原来的主人，难道说……",
      "channel": "thought",
      "mode": "conjecture",
      "holder": "r_su",
      "about": [
        "r_book",
        "r_owner"
      ]
    },
    {
      "id": "d23",
      "from": 41,
      "to": 41,
      "text": "古书说既然苏天晴这么满意，就可以直接快进到下个步骤了。",
      "channel": "speech",
      "mode": "plan",
      "holder": "r_book",
      "about": [
        "r_su"
      ]
    },
    {
      "id": "d24",
      "from": 43,
      "to": 43,
      "text": "古书叫苏天晴听着。",
      "channel": "speech",
      "mode": "request",
      "holder": "r_book",
      "about": [
        "r_su"
      ]
    },
    {
      "id": "d25",
      "from": 44,
      "to": 44,
      "text": "古书告诉苏天晴：她是墨丘利秘典的最佳适格者，作为星界使者会引导她走上完美生活，她只需要签订一个小小的契约。",
      "channel": "speech",
      "mode": "promise",
      "holder": "r_book",
      "about": [
        "r_su",
        "r_book"
      ]
    },
    {
      "id": "d26",
      "from": 45,
      "to": 45,
      "text": "苏天晴立即答应：好，我签。",
      "channel": "speech",
      "mode": "promise",
      "holder": "r_su",
      "about": [
        "r_book"
      ]
    },
    {
      "id": "d27",
      "from": 46,
      "to": 46,
      "text": "古书发出疑问：啊？",
      "channel": "speech",
      "mode": "question",
      "holder": "r_book",
      "about": []
    },
    {
      "id": "d28",
      "from": 48,
      "to": 48,
      "text": "古书说苏天晴不按套路出牌，质疑契约怎么说签就签、都不犹豫考虑一下。",
      "channel": "speech",
      "mode": "question",
      "holder": "r_book",
      "about": [
        "r_su"
      ]
    },
    {
      "id": "d29",
      "from": 49,
      "to": 49,
      "text": "苏天晴说古书思想狭隘，并称它为小破书。",
      "channel": "speech",
      "mode": "assertion",
      "holder": "r_su",
      "about": [
        "r_book"
      ]
    },
    {
      "id": "d30",
      "from": 50,
      "to": 50,
      "text": "苏天晴问古书：世界上最通用的愿望是哪两个。",
      "channel": "speech",
      "mode": "question",
      "holder": "r_su",
      "about": [
        "r_book"
      ]
    },
    {
      "id": "d31",
      "from": 51,
      "to": 51,
      "text": "古书反问：哪两个？",
      "channel": "speech",
      "mode": "question",
      "holder": "r_book",
      "about": []
    },
    {
      "id": "d32",
      "from": 53,
      "to": 53,
      "text": "苏天晴宣称取之不尽的财富以及变成萝莉是世界上最通用的两个愿望。",
      "channel": "speech",
      "mode": "assertion",
      "holder": "r_su",
      "about": []
    },
    {
      "id": "d33",
      "from": 55,
      "to": 55,
      "text": "苏天晴说变成萝莉本身就是最大的奖励，更何况是这样一只可爱的狐狐。",
      "channel": "speech",
      "mode": "assertion",
      "holder": "r_su",
      "about": [
        "r_su"
      ]
    },
    {
      "id": "d34",
      "from": 58,
      "to": 58,
      "text": "古书问既然苏天晴答应，契约就算成立了？",
      "channel": "speech",
      "mode": "question",
      "holder": "r_book",
      "about": [
        "r_su"
      ]
    },
    {
      "id": "d35",
      "from": 59,
      "to": 59,
      "text": "苏天晴回答：成立。",
      "channel": "speech",
      "mode": "assertion",
      "holder": "r_su",
      "about": [
        "r_book"
      ]
    },
    {
      "id": "d36",
      "from": 61,
      "to": 61,
      "text": "苏天晴问能否询问契约的具体内容。",
      "channel": "speech",
      "mode": "question",
      "holder": "r_su",
      "about": [
        "r_book"
      ]
    },
    {
      "id": "d37",
      "from": 62,
      "to": 62,
      "text": "苏天晴心想，总不能是激活了奇怪的奴隶契约吧，那样的话可就亏大发了。",
      "channel": "thought",
      "mode": "conjecture",
      "holder": "r_su",
      "about": []
    },
    {
      "id": "d38",
      "from": 63,
      "to": 63,
      "text": "古书回答契约内容是：反派魔法少女。",
      "channel": "speech",
      "mode": "assertion",
      "holder": "r_book",
      "about": []
    },
    {
      "id": "d39",
      "from": 66,
      "to": 66,
      "text": "古书宣称契约已签订，从今天起苏天晴将成为魔法少女活跃于世，造物主给她量身定制了一整套任务，能帮助她逐步走上反派魔法少女的顶点。",
      "channel": "speech",
      "mode": "promise",
      "holder": "r_book",
      "about": [
        "r_su",
        "r_creator"
      ]
    },
    {
      "id": "d40",
      "from": 67,
      "to": 67,
      "text": "苏天晴震惊地质问魔法少女是怎么回事，是否是死亡率高达90%的高危职业。",
      "channel": "speech",
      "mode": "question",
      "holder": "r_su",
      "about": []
    },
    {
      "id": "d41",
      "from": 68,
      "to": 68,
      "text": "古书回答：放心吧，是王道系的那种。",
      "channel": "speech",
      "mode": "assertion",
      "holder": "r_book",
      "about": []
    },
    {
      "id": "d42",
      "from": 69,
      "to": 69,
      "text": "苏天晴反问：就是这样才不对，在王道故事里当反派不是纯纯的找死吗。",
      "channel": "speech",
      "mode": "question",
      "holder": "r_su",
      "about": []
    },
    {
      "id": "d43",
      "from": 71,
      "to": 71,
      "text": "苏天晴心想，王道系是魔法少女们面对强敌逐渐成长后喊着友情和羁绊把反派干碎的故事；就算反派有系统有任务也很难在王道系故事里把主角干碎。",
      "channel": "thought",
      "mode": "conjecture",
      "holder": "r_su",
      "about": []
    },
    {
      "id": "d44",
      "from": 72,
      "to": 72,
      "text": "苏天晴心想自己还能否反悔，能否被送回原来的身体，觉得急性心肌梗死还有抢救机会。",
      "channel": "thought",
      "mode": "question",
      "holder": "r_su",
      "about": [
        "r_su"
      ]
    },
    {
      "id": "d45",
      "from": 73,
      "to": 73,
      "text": "系统宣告：墨丘利秘典绑定成功。",
      "channel": "in-world-system",
      "mode": "assertion",
      "holder": null,
      "about": [
        "r_book"
      ]
    },
    {
      "id": "d46",
      "from": 75,
      "to": 75,
      "text": "系统宣告：契约成立。",
      "channel": "in-world-system",
      "mode": "assertion",
      "holder": null,
      "about": []
    },
    {
      "id": "d47",
      "from": 76,
      "to": 76,
      "text": "古书/系统宣告：走上反派魔法少女的道路吧，苏天晴。",
      "channel": "speech",
      "mode": "request",
      "holder": "r_book",
      "about": [
        "r_su"
      ]
    }
  ],
  "beats": [
    {
      "id": "b01",
      "from": 1,
      "to": 3,
      "gist": "章节标题、作者18+声明与分隔线。",
      "mode": "paratext",
      "about": []
    },
    {
      "id": "b02",
      "from": 4,
      "to": 6,
      "gist": "未知声音询问姓名，苏天晴回答；昏暗房间里传出女声和一道低沉言语。",
      "mode": "narrative",
      "about": [
        "r_su"
      ]
    },
    {
      "id": "b03",
      "from": 7,
      "to": 11,
      "gist": "苏天晴坐在床头，看见飘浮的黑色古书，并在落地镜中看到陌生的金毛狐女，金发、狐耳、大尾巴等特征显现。",
      "mode": "description",
      "about": [
        "r_su",
        "r_book"
      ]
    },
    {
      "id": "b04",
      "from": 12,
      "to": 13,
      "gist": "古书发出低沉言语表示知道了，苏天晴的注意力被拉回古书。",
      "mode": "narrative",
      "about": [
        "r_book",
        "r_su"
      ]
    },
    {
      "id": "b05",
      "from": 14,
      "to": 15,
      "gist": "苏天晴茫然，回想起五分钟前下班吃面时听见太奶说话，回头看见太奶编围巾，随后胸口一疼眼前一黑。",
      "mode": "exposition",
      "about": [
        "r_su",
        "r_tanai"
      ]
    },
    {
      "id": "b06",
      "from": 16,
      "to": 18,
      "gist": "苏天晴伸手薅自己的大尾巴，感受到柔顺触感和陌生拉拽感，耳朵竖起、整只狐绷直，惊叹触感真实。",
      "mode": "narrative",
      "about": [
        "r_su"
      ]
    },
    {
      "id": "b07",
      "from": 19,
      "to": 21,
      "gist": "古书问苏天晴在干嘛，不明白她为何薅自己的尾巴，心想不疼吗。",
      "mode": "narrative",
      "about": [
        "r_book",
        "r_su"
      ]
    },
    {
      "id": "b08",
      "from": 22,
      "to": 23,
      "gist": "苏天晴咳嗽掩饰尴尬，阻止古书继续说话，并飞快理清思绪。",
      "mode": "narrative",
      "about": [
        "r_su",
        "r_book"
      ]
    },
    {
      "id": "b09",
      "from": 24,
      "to": 26,
      "gist": "苏天晴心想自己重生了，重生成金毛狐女，并疑惑眼前这本会说话的黑书是怎么回事。",
      "mode": "reflection",
      "about": [
        "r_su",
        "r_book"
      ]
    },
    {
      "id": "b10",
      "from": 27,
      "to": 30,
      "gist": "苏天晴问古书是谁；古书自称墨丘利秘典，从星空彼岸来寻找最优秀的适格者，并说那人就是苏天晴。",
      "mode": "narrative",
      "about": [
        "r_su",
        "r_book"
      ]
    },
    {
      "id": "b11",
      "from": 31,
      "to": 34,
      "gist": "苏天晴沉默思索后跳下床，走到落地镜前欣赏自己的小脚，心中评价完美、绝品。",
      "mode": "narrative",
      "about": [
        "r_su"
      ]
    },
    {
      "id": "b12",
      "from": 35,
      "to": 38,
      "gist": "古书说她似乎对现在的身体满意，又问她为什么盯着脚看；苏天晴回答小脚是世界上最美好的瑰宝。",
      "mode": "narrative",
      "about": [
        "r_book",
        "r_su"
      ]
    },
    {
      "id": "b13",
      "from": 39,
      "to": 40,
      "gist": "苏天晴对现状有了大概了解，意识到这本书知道自己并不是这副身体原来的主人。",
      "mode": "reflection",
      "about": [
        "r_su",
        "r_book",
        "r_owner"
      ]
    },
    {
      "id": "b14",
      "from": 41,
      "to": 42,
      "gist": "古书说既然满意就可以直接快进到下个步骤；苏天晴转身正视古书。",
      "mode": "narrative",
      "about": [
        "r_book",
        "r_su"
      ]
    },
    {
      "id": "b15",
      "from": 43,
      "to": 44,
      "gist": "古书叫苏天晴听着，称她是最佳适格者，作为星界使者会引导她走上完美生活，只需签订小契约。",
      "mode": "narrative",
      "about": [
        "r_book",
        "r_su"
      ]
    },
    {
      "id": "b16",
      "from": 45,
      "to": 48,
      "gist": "苏天晴立刻说好我签；古书凌乱，质疑她为何不按套路出牌、连契约都不犹豫就签。",
      "mode": "narrative",
      "about": [
        "r_su",
        "r_book"
      ]
    },
    {
      "id": "b17",
      "from": 49,
      "to": 55,
      "gist": "苏天晴说古书思想狭隘，提出世界上最通用的两个愿望是取之不尽的财富和变成萝莉，并称变成可爱狐狐本身就是最大奖励。",
      "mode": "narrative",
      "about": [
        "r_su",
        "r_book"
      ]
    },
    {
      "id": "b18",
      "from": 56,
      "to": 57,
      "gist": "短暂沉默后，古书迅速把话题拖回正题。",
      "mode": "narrative",
      "about": [
        "r_book"
      ]
    },
    {
      "id": "b19",
      "from": 58,
      "to": 59,
      "gist": "古书问既然苏天晴答应契约是否成立；苏天晴回答成立。",
      "mode": "narrative",
      "about": [
        "r_book",
        "r_su"
      ]
    },
    {
      "id": "b20",
      "from": 60,
      "to": 62,
      "gist": "苏天晴突然反应过来，询问契约具体内容，并担心会不会是奇怪的奴隶契约。",
      "mode": "narrative",
      "about": [
        "r_su"
      ]
    },
    {
      "id": "b21",
      "from": 63,
      "to": 64,
      "gist": "古书毫无停顿地回答契约内容是反派魔法少女。",
      "mode": "narrative",
      "about": [
        "r_book"
      ]
    },
    {
      "id": "b22",
      "from": 65,
      "to": 66,
      "gist": "苏天晴啊了一声；古书解释契约已签订，她将作为魔法少女活跃，造物主为她定制任务，帮助她走上反派魔法少女的顶点。",
      "mode": "exposition",
      "about": [
        "r_book",
        "r_su",
        "r_creator"
      ]
    },
    {
      "id": "b23",
      "from": 67,
      "to": 69,
      "gist": "苏天晴惊慌质问魔法少女是不是高危职业；古书说是王道系那种；苏天晴反驳在王道故事里当反派是纯纯找死。",
      "mode": "narrative",
      "about": [
        "r_su",
        "r_book"
      ]
    },
    {
      "id": "b24",
      "from": 70,
      "to": 72,
      "gist": "苏天晴后悔，心想王道系中反派难以干碎主角，想反悔、回到原来的身体，并觉得急性心肌梗死或许还有抢救机会。",
      "mode": "reflection",
      "about": [
        "r_su"
      ]
    },
    {
      "id": "b25",
      "from": 73,
      "to": 74,
      "gist": "脑中响起墨丘利秘典绑定成功的系统声，苏天晴欲哭无泪。",
      "mode": "narrative",
      "about": [
        "r_book",
        "r_su"
      ]
    },
    {
      "id": "b26",
      "from": 75,
      "to": 76,
      "gist": "系统宣告契约成立，并让苏天晴走上反派魔法少女的道路。",
      "mode": "narrative",
      "about": [
        "r_book",
        "r_su"
      ]
    }
  ]
}
