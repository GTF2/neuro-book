  "disclosures": [
    {
      "id": "d_adult",
      "from": 2,
      "to": 2,
      "text": "作者严正声明：本书出场角色均已满18岁，不存在任何未成年人。",
      "channel": "author",
      "mode": "assertion",
      "holder": null,
      "about": []
    },
    {
      "id": "d_ask_name",
      "from": 4,
      "to": 4,
      "text": "有个声音询问姓名：“【姓名。】”",
      "channel": "voice",
      "mode": "question",
      "holder": null,
      "about": []
    },
    {
      "id": "d_answer_name",
      "from": 5,
      "to": 5,
      "text": "有人回答姓名：“……苏天晴。”",
      "channel": "speech",
      "mode": "assertion",
      "holder": null,
      "about": []
    },
    {
      "id": "d_room_voices",
      "from": 6,
      "to": 6,
      "text": "昏暗房间里传出清脆悦耳的女声，还有一道仿佛来自遥远彼方的低沉言语。",
      "channel": "narrator",
      "mode": "assertion",
      "holder": null,
      "about": []
    },
    {
      "id": "d_mercury_hmm",
      "from": 12,
      "to": 12,
      "text": "低沉言语应声：“【嗯嗯……这样啊……】”",
      "channel": "voice",
      "mode": "assertion",
      "holder": "MercuryTome",
      "about": []
    },
    {
      "id": "d_memory_death",
      "from": 15,
      "to": 15,
      "text": "苏天晴回忆：五分钟前，结束连续三个夜班后刚下班的自己坐在街边面摊吃加煎蛋的豪华牛肉面并加辣椒面；突然听到太奶在背后说话，回头看到太奶坐藤椅编围巾，随后胸口一疼、眼前一黑，背过气去。",
      "channel": "thought",
      "mode": "assertion",
      "holder": "SuTianqing",
      "about": []
    },
    {
      "id": "d_tail_touch",
      "from": 16,
      "to": 18,
      "text": "苏天晴伸手用力薅自己炸毛的大尾巴；尾巴触感柔顺，但陌生的摩挲拉拽感从尾巴尖直冲天灵盖，惊得两只耳朵竖起、整只狐绷直；她觉得触感好真实。",
      "channel": "narrator",
      "mode": "assertion",
      "holder": null,
      "about": [
        "SuTianqing",
        "GoldenFoxBody"
      ]
    },
    {
      "id": "d_mercury_tail_question",
      "from": 19,
      "to": 19,
      "text": "古书问：“……你干嘛呢。”",
      "channel": "speech",
      "mode": "question",
      "holder": "MercuryTome",
      "about": [
        "SuTianqing"
      ]
    },
    {
      "id": "d_mercury_tail_thought",
      "from": 20,
      "to": 21,
      "text": "古书不明白眼前这只狐狐为什么要突然用怪异手法薅她自己的尾巴，心想不疼吗？",
      "channel": "thought",
      "mode": "question",
      "holder": "MercuryTome",
      "about": [
        "SuTianqing",
        "GoldenFoxBody"
      ]
    },
    {
      "id": "d_su_stop",
      "from": 22,
      "to": 23,
      "text": "苏天晴干咳掩饰尴尬，阻止古书继续说话，并飞快理清思绪。",
      "channel": "narrator",
      "mode": "assertion",
      "holder": null,
      "about": [
        "SuTianqing",
        "MercuryTome"
      ]
    },
    {
      "id": "d_su_reborn_assert",
      "from": 24,
      "to": 25,
      "text": "苏天晴想：我重生了，重生成了一只金毛狐女。",
      "channel": "thought",
      "mode": "assertion",
      "holder": "SuTianqing",
      "about": [
        "SuTianqing",
        "GoldenFoxBody"
      ]
    },
    {
      "id": "d_su_book_question",
      "from": 26,
      "to": 26,
      "text": "苏天晴想：眼前这本黑色会说话的书是怎么回事？有人能给我解释一下吗？",
      "channel": "thought",
      "mode": "question",
      "holder": "SuTianqing",
      "about": [
        "MercuryTome"
      ]
    },
    {
      "id": "d_su_who",
      "from": 27,
      "to": 27,
      "text": "苏天晴问古书：“你是谁？”",
      "channel": "speech",
      "mode": "question",
      "holder": "SuTianqing",
      "about": [
        "MercuryTome"
      ]
    },
    {
      "id": "d_mercury_intro",
      "from": 29,
      "to": 30,
      "text": "古书自称墨丘利秘典，从星空彼岸远行至此，前来寻找其最优秀的适格者；并称那个人就是苏天晴小姐。",
      "channel": "speech",
      "mode": "assertion",
      "holder": "MercuryTome",
      "about": [
        "SuTianqing"
      ]
    },
    {
      "id": "d_su_foot",
      "from": 32,
      "to": 34,
      "text": "苏天晴照镜欣赏自己白皙软嫩带红晕的小脚，认为完美、绝品。",
      "channel": "thought",
      "mode": "assertion",
      "holder": "SuTianqing",
      "about": [
        "GoldenFoxBody"
      ]
    },
    {
      "id": "d_mercury_body_satisfied",
      "from": 35,
      "to": 35,
      "text": "古书说：“看来你对现在的身体很满意嘛。”",
      "channel": "speech",
      "mode": "assertion",
      "holder": "MercuryTome",
      "about": [
        "SuTianqing",
        "GoldenFoxBody"
      ]
    },
    {
      "id": "d_mercury_foot_question",
      "from": 37,
      "to": 37,
      "text": "古书问苏天晴为什么盯着脚看，并说正常情况下不应该是……",
      "channel": "speech",
      "mode": "question",
      "holder": "MercuryTome",
      "about": [
        "SuTianqing",
        "GoldenFoxBody"
      ]
    },
    {
      "id": "d_su_foot_reply",
      "from": 38,
      "to": 38,
      "text": "苏天晴说：“你不懂，小脚才是世界上最美好的瑰宝，吃饭的时候看见了都能多炫两碗。”",
      "channel": "speech",
      "mode": "assertion",
      "holder": "SuTianqing",
      "about": [
        "GoldenFoxBody"
      ]
    },
    {
      "id": "d_su_current_guess",
      "from": 39,
      "to": 40,
      "text": "苏天晴嘴上回答古书，脑中大致了解现状；她猜想这本书知道自己并不是这副身体原来的主人，因而怀疑这意味着什么。",
      "channel": "thought",
      "mode": "conjecture",
      "holder": "SuTianqing",
      "about": [
        "MercuryTome",
        "GoldenFoxBody"
      ]
    },
    {
      "id": "d_mercury_next",
      "from": 41,
      "to": 41,
      "text": "古书说既然苏天晴满意，可以直接快进到下个步骤。",
      "channel": "speech",
      "mode": "plan",
      "holder": "MercuryTome",
      "about": [
        "SuTianqing",
        "GoldenFoxBody"
      ]
    },
    {
      "id": "d_mercury_contract_offer",
      "from": 43,
      "to": 44,
      "text": "古书对苏天晴说：你是墨丘利秘典的最佳适格者，作为星界使者，我会引导你走上完美的生活，而你只需要与我签订一个小小的契约——",
      "channel": "speech",
      "mode": "promise",
      "holder": "MercuryTome",
      "about": [
        "SuTianqing"
      ]
    },
    {
      "id": "d_su_sign",
      "from": 45,
      "to": 45,
      "text": "苏天晴说：“好，我签。”",
      "channel": "speech",
      "mode": "promise",
      "holder": "SuTianqing",
      "about": [
        "Contract"
      ]
    },
    {
      "id": "d_mercury_ah",
      "from": 46,
      "to": 46,
      "text": "古书发出：“……啊？”",
      "channel": "speech",
      "mode": "question",
      "holder": "MercuryTome",
      "about": [
        "SuTianqing"
      ]
    },
    {
      "id": "d_mercury_surprise",
      "from": 48,
      "to": 48,
      "text": "古书说：不是，你不按套路出牌啊，契约怎么说签就签的？都不犹豫考虑一下吗？",
      "channel": "speech",
      "mode": "question",
      "holder": "MercuryTome",
      "about": [
        "SuTianqing",
        "Contract"
      ]
    },
    {
      "id": "d_su_narrow",
      "from": 49,
      "to": 49,
      "text": "苏天晴严肃地说古书思想狭隘，并称其为小破书。",
      "channel": "speech",
      "mode": "assertion",
      "holder": "SuTianqing",
      "about": [
        "MercuryTome"
      ]
    },
    {
      "id": "d_su_wish_question",
      "from": 50,
      "to": 50,
      "text": "苏天晴问古书：世界上最通用的愿望是哪两个。",
      "channel": "speech",
      "mode": "question",
      "holder": "SuTianqing",
      "about": [
        "MercuryTome"
      ]
    },
    {
      "id": "d_mercury_wish_which",
      "from": 51,
      "to": 51,
      "text": "古书反问：“……哪两个？”",
      "channel": "speech",
      "mode": "question",
      "holder": "MercuryTome",
      "about": [
        "SuTianqing"
      ]
    },
    {
      "id": "d_su_two_wishes",
      "from": 53,
      "to": 53,
      "text": "苏天晴宣称取之不尽的财富以及变成萝莉是世界上最通用的两个愿望。",
      "channel": "speech",
      "mode": "assertion",
      "holder": "SuTianqing",
      "about": []
    },
    {
      "id": "d_su_loli_reward",
      "from": 55,
      "to": 55,
      "text": "苏天晴说变成萝莉本身就是最大的奖励，更何况还是这样一只可爱的狐狐。",
      "channel": "speech",
      "mode": "assertion",
      "holder": "SuTianqing",
      "about": [
        "GoldenFoxBody"
      ]
    },
    {
      "id": "d_mercury_contract_confirm",
      "from": 58,
      "to": 58,
      "text": "古书问：既然苏天晴答应，他们之间的契约就算成立了？",
      "channel": "speech",
      "mode": "question",
      "holder": "MercuryTome",
      "about": [
        "SuTianqing",
        "Contract"
      ]
    },
    {
      "id": "d_su_contract_agree",
      "from": 59,
      "to": 59,
      "text": "苏天晴不假思索地说：“成立。”",
      "channel": "speech",
      "mode": "assertion",
      "holder": "SuTianqing",
      "about": [
        "Contract"
      ]
    },
    {
      "id": "d_su_contract_ask",
      "from": 60,
      "to": 61,
      "text": "苏天晴好奇地问能否问问契约的具体内容。",
      "channel": "speech",
      "mode": "question",
      "holder": "SuTianqing",
      "about": [
        "Contract"
      ]
    },
    {
      "id": "d_su_slave_worry",
      "from": 62,
      "to": 62,
      "text": "苏天晴心想：总不能是激活了什么奇怪的奴隶契约吧！那样的话可就亏大发了！",
      "channel": "thought",
      "mode": "conjecture",
      "holder": "SuTianqing",
      "about": [
        "Contract"
      ]
    },
    {
      "id": "d_mercury_villain_magical",
      "from": 63,
      "to": 64,
      "text": "古书没有丝毫停顿地说，契约内容是“反派魔法少女”。",
      "channel": "speech",
      "mode": "assertion",
      "holder": "MercuryTome",
      "about": [
        "Contract",
        "MagicalGirlRole"
      ]
    },
    {
      "id": "d_mercury_become_magical",
      "from": 66,
      "to": 66,
      "text": "古书说：既然契约已经签订，从今天开始，苏天晴将成为魔法少女活跃于世；造物主给苏天晴量身定制了一整套任务，能帮助她逐步走上反派魔法少女的顶点！",
      "channel": "speech",
      "mode": "assertion",
      "holder": "MercuryTome",
      "about": [
        "SuTianqing",
        "Contract",
        "MagicalGirlRole"
      ]
    },
    {
      "id": "d_su_danger_question",
      "from": 67,
      "to": 67,
      "text": "苏天晴问：魔法少女是怎么回事？是那种死亡率高达90%的高危职业吗？",
      "channel": "speech",
      "mode": "question",
      "holder": "SuTianqing",
      "about": [
        "MagicalGirlRole"
      ]
    },
    {
      "id": "d_mercury_wangdao",
      "from": 68,
      "to": 68,
      "text": "古书说：放心吧，是王道系的那种。",
      "channel": "speech",
      "mode": "assertion",
      "holder": "MercuryTome",
      "about": [
        "MagicalGirlRole"
      ]
    },
    {
      "id": "d_su_retort",
      "from": 69,
      "to": 69,
      "text": "苏天晴反驳：就是这样才不对吧！在王道故事里当反派不是纯纯的找死吗！",
      "channel": "speech",
      "mode": "denial",
      "holder": "SuTianqing",
      "about": [
        "MagicalGirlRole"
      ]
    },
    {
