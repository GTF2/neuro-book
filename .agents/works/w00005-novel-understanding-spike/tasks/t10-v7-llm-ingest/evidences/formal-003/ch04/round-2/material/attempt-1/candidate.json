          "r_heroassociation",
          "r_park"
        ]
      },
      {
        "id": "b5",
        "from": 9,
        "to": 13,
        "gist": "风信子落地绿心公园，公园昏黑安静，居民已疏散，她握紧魔杖警惕四周。",
        "mode": "description",
        "about": [
          "r_wind",
          "r_park",
          "r_wand"
        ]
      },
      {
        "id": "b6",
        "from": 14,
        "to": 18,
