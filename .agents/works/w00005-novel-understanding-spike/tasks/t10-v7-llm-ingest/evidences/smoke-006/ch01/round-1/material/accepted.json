      "mode": "assertion",
      "holder": "r_codex",
      "about": [
        "r_su"
      ]
    },
    {
      "id": "d_su_villain_death",
      "from": 69,
      "to": 69,
      "text": "苏天晴说：“就是这样才不对吧！在王道故事里当反派不是纯纯的找死吗！”",
