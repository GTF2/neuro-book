    {
      "id": "d_su_ask_contract",
      "from": 61,
      "to": 61,
      "text": "苏天晴问：“那个……我能问问契约的具体内容吗？”",
      "channel": "speech",
      "mode": "question",
      "holder": "r_su",
      "about": [
        "r_codex",
        "r_contract"
      ]
    },
    {
      "id": "d_su_slave_worry",
      "from": 62,
      "to": 62,
      "text": "苏天晴心想，总不能是激活了什么奇怪的奴隶契约，那样可就亏大了。",
      "channel": "thought",
      "mode": "conjecture",
      "holder": "r_su",
      "about": [
        "r_su",
        "r_contract"
      ]
    },
    {
      "id": "d_book_villain_magical_girl",
      "from": 63,
      "to": 64,
