    {
      "id": "d_su_confirm",
      "from": 59,
      "to": 59,
      "text": "苏天晴不假思索地回答：“成立。”",
      "channel": "speech",
      "mode": "assertion",
      "holder": "r_su",
      "about": [
        "r_codex",
        "r_contract"
      ]
    },
    {
      "id": "d_fox_reacts",
      "from": 60,
      "to": 60,
      "text": "片刻后，狐狐突然反应过来了什么，好奇地问道。",
