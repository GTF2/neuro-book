  "disclosures": [
    {
      "id": "d_disclaimer",
      "from": 2,
      "to": 2,
      "text": "作者声明：本书出场角色均已满18岁，不存在任何未成年人。",
      "channel": "author",
      "mode": "assertion",
      "holder": null,
      "about": []
    },
    {
      "id": "d_name_ask",
      "from": 4,
      "to": 4,
      "text": "有人询问：“姓名。”",
      "channel": "voice",
      "mode": "question",
      "holder": null,
      "about": []
    },
    {
      "id": "d_name_answer",
      "from": 5,
      "to": 5,
      "text": "苏天晴说出自己的姓名：“苏天晴。”",
      "channel": "speech",
      "mode": "assertion",
      "holder": "r_su",
      "about": [
        "r_su"
      ]
    },
    {
      "id": "d_room_voice",
      "from": 6,
      "to": 6,
      "text": "昏暗的房间里传出清脆悦耳的女声，还有一道仿佛来自遥远彼方的低沉言语。",
      "channel": "narrator",
      "mode": "assertion",
      "holder": null,
      "about": []
    },
    {
      "id": "d_su_sees_book_mirror",
      "from": 7,
      "to": 7,
      "text": "苏天晴坐在床头，看着飘浮在半空中的黑色古书，并从落地镜中瞥见一道陌生的娇小身影。",
      "channel": "narrator",
      "mode": "assertion",
      "holder": null,
      "about": [
        "r_su",
        "r_codex",
        "r_fox_body"
      ]
    },
    {
      "id": "d_fox_description",
      "from": 8,
      "to": 11,
      "text": "镜中身影有金色长发、毛茸茸耳朵和白皙肌肤，是一只娇小的金毛狐女；加上背后炸毛的大尾巴，应是乖巧可爱的毛茸茸金毛狐狐。",
      "channel": "narrator",
      "mode": "assertion",
      "holder": null,
      "about": [
        "r_fox_body"
      ]
    },
    {
      "id": "d_book_ack",
      "from": 12,
      "to": 12,
      "text": "黑色古书发出“嗯嗯……这样啊……”的回应。",
      "channel": "speech",
      "mode": "assertion",
      "holder": "r_codex",
      "about": [
        "r_su"
      ]
    },
    {
      "id": "d_voice_pulls",
      "from": 13,
      "to": 13,
      "text": "房间中的低沉言语再次响起，将苏天晴的注意力拽回黑色古书。",
      "channel": "narrator",
      "mode": "assertion",
      "holder": null,
      "about": [
        "r_su",
        "r_codex"
      ]
    },
    {
      "id": "d_su_dazed",
      "from": 14,
      "to": 14,
      "text": "苏天晴有些茫然。",
      "channel": "thought",
      "mode": "assertion",
      "holder": "r_su",
      "about": [
        "r_su"
      ]
    },
    {
      "id": "d_memory",
      "from": 15,
      "to": 15,
      "text": "苏天晴回忆起五分钟前：连续三个夜班下班后，她在街边面摊吃加煎蛋的牛肉面，听到太奶在背后说话，回头看到太奶坐在藤椅上编围巾，随后胸口一疼、眼前一黑。",
      "channel": "thought",
      "mode": "assertion",
      "holder": "r_su",
      "about": [
        "r_su",
        "r_grandma"
      ]
    },
    {
      "id": "d_tail_touch",
      "from": 16,
      "to": 17,
      "text": "苏天晴伸手在身侧炸毛大尾巴上用力薅了一把，感到无比柔顺的触感，同时从尾巴尖传来陌生的摩挲拉拽感，使狐的耳朵竖起、身体绷直。",
      "channel": "narrator",
      "mode": "assertion",
      "holder": null,
      "about": [
        "r_su",
        "r_fox_body"
      ]
    },
    {
      "id": "d_real_touch",
      "from": 18,
      "to": 18,
      "text": "苏天晴心想触感好真实。",
      "channel": "thought",
      "mode": "assertion",
      "holder": "r_su",
      "about": [
        "r_su",
        "r_fox_body"
      ]
    },
    {
      "id": "d_book_asks_why",
      "from": 19,
      "to": 19,
      "text": "古书问苏天晴：“……你干嘛呢。”",
      "channel": "speech",
      "mode": "question",
      "holder": "r_codex",
      "about": [
        "r_su"
      ]
    },
    {
      "id": "d_book_confused",
      "from": 20,
      "to": 21,
      "text": "古书不明白眼前这只狐狐为什么要突然用怪异的手法去薅她自己的尾巴，心想不疼吗。",
      "channel": "thought",
      "mode": "question",
      "holder": "r_codex",
      "about": [
        "r_fox_body"
      ]
    },
    {
      "id": "d_su_wait",
      "from": 22,
      "to": 23,
      "text": "苏天晴干咳两声掩饰尴尬，伸手阻止古书继续说话，说：“咳咳！等一下，稍等一下！”并飞快理清思绪。",
      "channel": "speech",
      "mode": "request",
      "holder": "r_su",
      "about": [
        "r_codex"
      ]
    },
    {
      "id": "d_su_reborn",
      "from": 24,
      "to": 25,
      "text": "苏天晴意识到：我重生了，重生成了一只金毛狐女。",
      "channel": "thought",
      "mode": "assertion",
      "holder": "r_su",
      "about": [
        "r_su",
        "r_fox_body"
      ]
    },
    {
      "id": "d_su_question_book",
      "from": 26,
      "to": 26,
      "text": "苏天晴心想，眼前这本会说话的黑色古书是怎么回事，有人能解释一下吗。",
      "channel": "thought",
      "mode": "question",
      "holder": "r_su",
      "about": [
        "r_su",
        "r_codex"
      ]
    },
    {
      "id": "d_su_asks_who",
      "from": 27,
      "to": 27,
      "text": "苏天晴扭头正视古书，问：“你是谁？”",
      "channel": "speech",
      "mode": "question",
      "holder": "r_su",
      "about": [
        "r_codex"
      ]
    },
    {
      "id": "d_book_repeats",
      "from": 28,
      "to": 28,
      "text": "古书沉默了一会儿，像在思考眼前这只狐狐是不是自己要找的人，随后重复两分钟前的开场白。",
      "channel": "narrator",
      "mode": "assertion",
      "holder": null,
      "about": [
        "r_codex",
        "r_fox_body"
      ]
    },
    {
      "id": "d_book_declares",
      "from": 29,
      "to": 30,
      "text": "墨丘利秘典自称从星空彼岸远行至此，前来寻找最优秀的适格者，并说那个人就是苏天晴小姐。",
      "channel": "speech",
      "mode": "assertion",
      "holder": "r_codex",
      "about": [
        "r_codex",
        "r_su"
      ]
    },
    {
      "id": "d_su_silent",
      "from": 31,
      "to": 31,
      "text": "再次听完中二台词后，苏天晴又陷入沉默与思索。",
      "channel": "thought",
      "mode": "assertion",
      "holder": "r_su",
      "about": [
        "r_su",
        "r_codex"
      ]
    },
    {
      "id": "d_mirror_foot",
      "from": 32,
      "to": 33,
      "text": "苏天晴从床上蹦下，走到落地镜前，沉默地看向镜中穿着宽松睡裙的娇小身影，并抬脚欣赏自己的小脚。",
      "channel": "narrator",
      "mode": "assertion",
      "holder": null,
      "about": [
        "r_su",
        "r_fox_body"
      ]
    },
    {
      "id": "d_foot_praise",
      "from": 34,
      "to": 34,
      "text": "苏天晴心想：“嗯，完美，绝品。”",
      "channel": "thought",
      "mode": "assertion",
      "holder": "r_su",
      "about": [
        "r_fox_body"
      ]
    },
    {
      "id": "d_book_body_satisfied",
      "from": 35,
      "to": 35,
      "text": "古书说：“看来你对现在的身体很满意嘛。”",
      "channel": "speech",
      "mode": "assertion",
      "holder": "r_codex",
      "about": [
        "r_su",
        "r_fox_body"
      ]
    },
    {
      "id": "d_book_speechless",
      "from": 36,
      "to": 36,
      "text": "古书瞅见狐狐认真欣赏脚丫，一时语塞，憋了半天才冒出这么一句。",
      "channel": "narrator",
      "mode": "assertion",
      "holder": null,
      "about": [
        "r_codex",
        "r_fox_body"
      ]
    },
    {
      "id": "d_book_asks_foot",
      "from": 37,
      "to": 37,
      "text": "古书问：“但是你为什么要盯着脚看？正常情况下不应该是……”",
      "channel": "speech",
      "mode": "question",
      "holder": "r_codex",
      "about": [
        "r_su",
        "r_fox_body"
      ]
    },
    {
      "id": "d_su_feet_answer",
      "from": 38,
      "to": 38,
      "text": "苏天晴回答：“你不懂，小脚才是世界上最美好的瑰宝，吃饭的时候看见了都能多炫两碗。”",
      "channel": "speech",
      "mode": "assertion",
      "holder": "r_su",
      "about": [
        "r_codex"
      ]
    },
    {
      "id": "d_su_understands",
      "from": 39,
      "to": 39,
      "text": "苏天晴嘴上不搭调地回答古书的话，脑子里却对现状有了个大概的了解。",
      "channel": "thought",
      "mode": "assertion",
      "holder": "r_su",
      "about": [
        "r_su"
      ]
    },
    {
      "id": "d_su_conjecture_owner",
      "from": 40,
      "to": 40,
      "text": "苏天晴猜想这本书知道自己并不是这副身体原来的主人。",
      "channel": "thought",
      "mode": "conjecture",
      "holder": "r_su",
      "about": [
        "r_codex",
        "r_original_owner"
      ]
    },
    {
      "id": "d_book_next_step",
      "from": 41,
      "to": 41,
      "text": "古书说：“既然你这么满意，那咱们可以直接快进到下个步骤了。”",
      "channel": "speech",
      "mode": "plan",
      "holder": "r_codex",
      "about": [
        "r_su",
        "r_fox_body"
      ]
    },
    {
      "id": "d_book_pulls_back",
      "from": 42,
      "to": 42,
      "text": "古书将苏天晴从欣赏狐狐身躯中唤回，她转身正视着它。",
      "channel": "narrator",
      "mode": "assertion",
      "holder": null,
      "about": [
        "r_su",
        "r_codex",
        "r_fox_body"
      ]
    },
    {
      "id": "d_book_contract_offer",
      "from": 43,
      "to": 44,
      "text": "墨丘利秘典对苏天晴说，她是其最佳适格者，作为星界使者会引导她走上完美生活，她只需与其签订一个小小的契约。",
      "channel": "speech",
      "mode": "promise",
      "holder": "r_codex",
      "about": [
        "r_codex",
        "r_su",
        "r_contract"
      ]
    },
    {
      "id": "d_su_sign",
      "from": 45,
      "to": 45,
      "text": "苏天晴回答：“好，我签。”",
      "channel": "speech",
      "mode": "promise",
      "holder": "r_su",
      "about": [
        "r_codex",
        "r_contract"
      ]
    },
    {
      "id": "d_book_ah",
      "from": 46,
      "to": 46,
      "text": "古书发出：“……啊？”",
      "channel": "speech",
      "mode": "question",
      "holder": "r_codex",
      "about": []
    },
    {
      "id": "d_book_flustered",
      "from": 47,
      "to": 47,
      "text": "古书凌乱了一下。",
      "channel": "narrator",
      "mode": "assertion",
      "holder": null,
      "about": [
        "r_codex"
      ]
    },
    {
      "id": "d_book_questions_signing",
      "from": 48,
      "to": 48,
      "text": "古书问苏天晴怎么契约说签就签，都不犹豫考虑一下。",
      "channel": "speech",
      "mode": "question",
      "holder": "r_codex",
      "about": [
        "r_su",
        "r_contract"
      ]
    },
    {
      "id": "d_su_narrow",
      "from": 49,
      "to": 49,
      "text": "苏天晴对古书说：“这就是你思想狭隘了，小破书。”",
      "channel": "speech",
      "mode": "assertion",
      "holder": "r_su",
      "about": [
        "r_codex"
      ]
    },
    {
      "id": "d_su_ask_two_wishes",
      "from": 50,
      "to": 50,
      "text": "苏天晴问：“我问你，世界上最通用的愿望是哪两个。”",
      "channel": "speech",
      "mode": "question",
      "holder": "r_su",
      "about": [
        "r_codex"
      ]
    },
    {
      "id": "d_book_which_two",
      "from": 51,
      "to": 51,
      "text": "古书愣愣地反问：“……哪两个？”",
      "channel": "speech",
      "mode": "question",
      "holder": "r_codex",
      "about": [
        "r_su"
      ]
    },
    {
      "id": "d_fox_gestures",
      "from": 52,
      "to": 52,
      "text": "金毛狐狐俯下身子，伸出两根手指在黑色古书面前晃动，身后大尾巴也摇曳起来。",
      "channel": "narrator",
      "mode": "assertion",
      "holder": null,
      "about": [
        "r_su",
        "r_fox_body",
        "r_codex"
      ]
    },
    {
      "id": "d_su_two_wishes",
      "from": 53,
      "to": 53,
      "text": "苏天晴宣称：“取之不尽的财富！以及变成萝莉！这是世界上最通用的两个愿望！”",
      "channel": "speech",
      "mode": "assertion",
      "holder": "r_su",
      "about": [
        "r_su"
      ]
    },
    {
      "id": "d_su_arms_glow",
      "from": 54,
      "to": 54,
      "text": "苏天晴张开双臂，满眼放光。",
      "channel": "narrator",
      "mode": "assertion",
      "holder": null,
      "about": [
        "r_su"
      ]
    },
    {
      "id": "d_su_loli_reward",
      "from": 55,
      "to": 55,
      "text": "苏天晴说：“变成萝莉本身就是最大的奖励，更何况还是这样一只可爱的狐狐！”",
      "channel": "speech",
      "mode": "assertion",
      "holder": "r_su",
      "about": [
        "r_su",
        "r_fox_body"
      ]
    },
    {
      "id": "d_silence",
      "from": 56,
      "to": 56,
      "text": "沉默。",
      "channel": "narrator",
      "mode": "assertion",
      "holder": null,
      "about": []
    },
    {
      "id": "d_book_returns_topic",
      "from": 57,
      "to": 57,
      "text": "古书并未因短时间的错乱呆愣太久，迅速又将话题拖回正题。",
      "channel": "narrator",
      "mode": "assertion",
      "holder": null,
      "about": [
        "r_codex"
      ]
    },
    {
      "id": "d_book_confirm_ask",
      "from": 58,
      "to": 58,
      "text": "古书问：“既然你答应，那我们之间的契约就算成立了？”",
      "channel": "speech",
      "mode": "question",
      "holder": "r_codex",
      "about": [
        "r_su",
        "r_codex",
        "r_contract"
      ]
