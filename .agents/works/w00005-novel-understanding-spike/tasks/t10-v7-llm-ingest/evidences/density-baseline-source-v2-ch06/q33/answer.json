          "items": [
            {
              "type": "source",
              "sourceId": "source-c06",
              "revision": 1,
              "chapter": 6,
              "paragraph": 66,
              "text": "“……那个金色头发的女孩子，白灵你知道多少。”"
            },
            {
              "type": "source",
              "sourceId": "source-c06",
              "revision": 1,
              "chapter": 6,
              "paragraph": 81,
              "text": "“白灵你别乱叫，吵死了。”南小风没好气地说道。"
            },
            {
              "type": "source",
              "sourceId": "source-c06",
              "revision": 1,
              "chapter": 6,
              "paragraph": 82,
              "text": "可白灵却满脸震惊地飞到书桌前，朝埋头苦干的南小风举起手中的手机。"
            },
            {
              "type": "source",
              "sourceId": "source-c06",
              "revision": 1,
              "chapter": 6,
              "paragraph": 86,
              "text": "白灵急得翅膀扑扇，强行把手机塞到南小风手里。"
            },
            {
              "type": "source",
              "sourceId": "source-c06",
              "revision": 1,
              "chapter": 6,
              "paragraph": 88,
              "text": "“魔法少女狐狐official？……白灵你在看什么奇怪的主播吗？”"
            },
            {
              "type": "source",
              "sourceId": "source-c06",
              "revision": 1,
              "chapter": 6,
              "paragraph": 90,
              "text": "白灵伸手按了一下手机屏幕，视频播放。"
            }
          ],
