      "about": []
    },
    {
      "id": "b3",
      "from": 3,
      "to": 3,
      "gist": "分隔线。",
      "mode": "paratext",
      "about": []
    },
    {
      "id": "b4",
      "from": 4,
      "to": 6,
      "gist": "墨丘利秘典询问姓名，苏天晴回答；昏暗房间中响起女声与低沉言语。",
      "mode": "narrative",
      "about": [
        "ref_book",
        "ref_su"
      ]
    },
    {
      "id": "b5",
      "from": 7,
      "to": 11,
      "gist": "苏天晴坐在床头看着飘浮的黑色古书，并从镜中看到自己成为娇小的金毛狐女：金发、狐耳、大尾巴。",
      "mode": "description",
      "about": [
        "ref_su",
        "ref_book",
        "ref_body"
      ]
    },
    {
      "id": "b6",
      "from": 12,
      "to": 14,
      "gist": "古书回应，低沉言语再次将苏天晴注意力拉回；苏天晴茫然。",
      "mode": "narrative",
      "about": [
        "ref_book",
        "ref_su"
      ]
    },
    {
      "id": "b7",
      "from": 15,
      "to": 15,
      "gist": "闪回：苏天晴连续夜班后吃牛肉面时听见太奶说话，回头见太奶编围巾，随即胸疼眼黑失去意识。",
      "mode": "exposition",
      "about": [
        "ref_su",
        "ref_great_grandmother"
      ]
    },
    {
      "id": "b8",
      "from": 16,
      "to": 18,
      "gist": "苏天晴薅自己尾巴，感到柔顺触感和陌生拉拽感，惊得狐耳竖起、身体绷直，觉得触感真实。",
      "mode": "narrative",
      "about": [
        "ref_su",
        "ref_body"
      ]
    },
    {
      "id": "b9",
      "from": 19,
      "to": 21,
      "gist": "古书问她在干什么，不理解她为何薅自己尾巴，疑惑不疼吗。",
      "mode": "narrative",
      "about": [
        "ref_book",
        "ref_su",
        "ref_body"
      ]
    },
    {
      "id": "b10",
      "from": 22,
      "to": 23,
      "gist": "苏天晴干咳掩饰尴尬，阻止古书说话并理清思绪。",
      "mode": "narrative",
      "about": [
        "ref_su",
        "ref_book"
      ]
    },
    {
      "id": "b11",
      "from": 24,
      "to": 26,
      "gist": "苏天晴意识到自己重生成了金毛狐女，并疑惑眼前会说话的黑书是什么，希望有人解释。",
      "mode": "reflection",
      "about": [
        "ref_su",
        "ref_body",
        "ref_book"
      ]
    },
    {
      "id": "b12",
      "from": 27,
      "to": 27,
      "gist": "苏天晴问古书“你是谁”。",
      "mode": "narrative",
      "about": [
        "ref_su",
        "ref_book"
      ]
    },
    {
      "id": "b13",
      "from": 28,
      "to": 31,
      "gist": "古书沉默思考后重复开场白，自称墨丘利秘典，从星空彼岸来寻找最优秀适格者，即苏天晴；苏天晴再次沉默思索。",
      "mode": "narrative",
      "about": [
        "ref_book",
        "ref_su"
      ]
    },
    {
      "id": "b14",
      "from": 32,
      "to": 34,
      "gist": "狐狐跳下床到镜前看娇小身影，又抬脚欣赏小脚，认为完美绝品。",
      "mode": "narrative",
      "about": [
        "ref_su",
        "ref_body"
      ]
    },
    {
      "id": "b15",
      "from": 35,
      "to": 37,
      "gist": "古书认为她对现在的身体满意，并问她为何盯着脚看，觉得正常情况下不该如此。",
      "mode": "narrative",
      "about": [
        "ref_book",
        "ref_su",
        "ref_body"
      ]
    },
    {
      "id": "b16",
      "from": 38,
      "to": 40,
      "gist": "苏天晴说小脚是瑰宝，同时心里对现状有大概了解，推断这本书知道她并非这副身体原来的主人。",
      "mode": "reflection",
      "about": [
        "ref_su",
        "ref_book",
        "ref_original_owner",
        "ref_body"
      ]
    },
    {
      "id": "b17",
      "from": 41,
      "to": 42,
      "gist": "古书提议直接快进到下个步骤，将苏天晴从发癫中唤回。",
      "mode": "narrative",
      "about": [
        "ref_book",
        "ref_su"
      ]
    },
    {
      "id": "b18",
      "from": 43,
      "to": 44,
      "gist": "古书让苏天晴听着，称她是最佳适格者，自己作为星界使者会引导她走上完美生活，她只需签订一个小契约。",
      "mode": "exposition",
      "about": [
        "ref_book",
        "ref_su"
      ]
    },
    {
      "id": "b19",
      "from": 45,
      "to": 49,
      "gist": "苏天晴立刻答应签约，古书凌乱质问为何不犹豫；苏天晴严肃说这是古书思想狭隘，并称它小破书。",
      "mode": "narrative",
      "about": [
        "ref_su",
        "ref_book"
      ]
    },
    {
      "id": "b20",
      "from": 50,
      "to": 55,
      "gist": "苏天晴问世界上最通用的两个愿望，随后给出答案：取之不尽的财富和变成萝莉；她说变成萝莉本身就是最大奖励，何况是可爱狐狐。",
      "mode": "narrative",
      "about": [
        "ref_su",
        "ref_book",
        "ref_body"
      ]
    },
    {
      "id": "b21",
      "from": 56,
      "to": 59,
      "gist": "短暂沉默后古书把话题拉回，确认契约是否成立；苏天晴不假思索说成立。",
      "mode": "narrative",
      "about": [
        "ref_book",
        "ref_su"
      ]
    },
    {
      "id": "b22",
      "from": 60,
      "to": 62,
      "gist": "苏天晴好奇询问契约具体内容，担心是奇怪的奴隶契约会亏大。",
      "mode": "reflection",
      "about": [
        "ref_su",
        "ref_book"
      ]
    },
    {
      "id": "b23",
      "from": 63,
      "to": 66,
      "gist": "古书回答契约内容是反派魔法少女，并宣布契约已签订：苏天晴将成为魔法少女活跃于世，造物主为她定制任务，帮助她走上反派魔法少女顶点。",
      "mode": "exposition",
      "about": [
        "ref_book",
        "ref_su",
        "ref_creator"
      ]
    },
    {
      "id": "b24",
      "from": 67,
      "to": 69,
      "gist": "苏天晴惊问魔法少女是否是死亡率90%的高危职业；古书说是王道系；苏天晴说在王道故事里当反派是找死。",
      "mode": "narrative",
      "about": [
        "ref_su",
        "ref_book"
      ]
    },
