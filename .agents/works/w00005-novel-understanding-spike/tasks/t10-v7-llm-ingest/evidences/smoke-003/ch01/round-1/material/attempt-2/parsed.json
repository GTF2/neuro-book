  "disclosures": [
    {
      "id": "d1",
      "from": 2,
      "to": 2,
      "text": "本书出场角色均已满18岁，不存在任何未成年人。",
      "channel": "author",
      "mode": "assertion",
      "holder": null,
      "about": []
    },
    {
      "id": "d2",
      "from": 4,
      "to": 4,
      "text": "古书要求苏天晴报出姓名。",
      "channel": "voice",
      "mode": "request",
      "holder": "MercuryCodex",
      "about": [
        "SuTianqing"
      ]
    },
    {
      "id": "d3",
      "from": 5,
      "to": 5,
      "text": "苏天晴说出自己的名字。",
      "channel": "speech",
      "mode": "assertion",
      "holder": "SuTianqing",
      "about": [
        "SuTianqing"
      ]
    },
    {
      "id": "d4",
      "from": 6,
      "to": 6,
      "text": "昏暗房间里传出清脆悦耳的女声，以及一道仿佛来自遥远彼方的低沉言语。",
      "channel": "narrator",
      "mode": "assertion",
      "holder": null,
      "about": [
        "SuTianqing",
        "MercuryCodex"
      ]
    },
    {
      "id": "d5",
      "from": 7,
      "to": 7,
      "text": "苏天晴坐在床头，呆滞地看着飘浮在半空中的黑色古书，并从落地镜中瞥见一道陌生的娇小身影。",
      "channel": "narrator",
      "mode": "assertion",
      "holder": null,
      "about": [
        "SuTianqing",
        "MercuryCodex",
        "FoxBody"
      ]
    },
    {
      "id": "d6",
      "from": 8,
      "to": 8,
      "text": "镜中身影有灿烂金色长发、头顶毛茸茸耳朵，刘海下五官精致。",
      "channel": "narrator",
      "mode": "assertion",
      "holder": null,
      "about": [
        "FoxBody"
      ]
    },
    {
      "id": "d7",
      "from": 10,
      "to": 10,
      "text": "镜中身影是一只娇小的金毛狐女。",
      "channel": "narrator",
      "mode": "assertion",
      "holder": null,
      "about": [
        "FoxBody"
      ]
    },
    {
      "id": "d8",
      "from": 12,
      "to": 12,
      "text": "古书以低沉言语表示知道了。",
      "channel": "voice",
      "mode": "assertion",
      "holder": "MercuryCodex",
      "about": [
        "SuTianqing"
      ]
    },
    {
      "id": "d9",
      "from": 13,
      "to": 13,
      "text": "房间中的低沉言语再次响起，将苏天晴的注意力拽回黑色古书。",
      "channel": "narrator",
      "mode": "assertion",
      "holder": null,
      "about": [
        "MercuryCodex",
        "SuTianqing"
      ]
    },
    {
      "id": "d10",
      "from": 15,
      "to": 15,
      "text": "五分钟前，刚结束连续三个夜班的苏天晴在街边面摊吃牛肉面时听到太奶在背后说话，回头看见太奶坐在藤椅上编围巾，随后胸口一疼、眼前一黑，背过气去。",
      "channel": "narrator",
      "mode": "assertion",
      "holder": null,
      "about": [
        "SuTianqing",
        "GreatGrandma"
      ]
    },
    {
      "id": "d11",
      "from": 16,
      "to": 16,
      "text": "苏天晴伸手在自己身侧的大尾巴上用力薅了一把。",
      "channel": "narrator",
      "mode": "assertion",
      "holder": null,
      "about": [
        "SuTianqing",
        "FoxBody"
      ]
    },
    {
      "id": "d12",
      "from": 17,
      "to": 17,
      "text": "尾巴传来柔顺触感，同时一股陌生的摩挲拉拽感从尾巴尖直冲天灵盖，使耳朵竖起、整只狐绷直身体。",
      "channel": "narrator",
      "mode": "assertion",
      "holder": null,
      "about": [
        "SuTianqing",
        "FoxBody"
      ]
    },
    {
      "id": "d13",
      "from": 18,
      "to": 18,
      "text": "苏天晴觉得触感好真实。",
      "channel": "thought",
      "mode": "assertion",
      "holder": "SuTianqing",
      "about": [
        "FoxBody"
      ]
    },
    {
      "id": "d14",
      "from": 19,
      "to": 19,
      "text": "古书问苏天晴在干什么。",
      "channel": "voice",
      "mode": "question",
      "holder": "MercuryCodex",
      "about": [
        "SuTianqing"
      ]
    },
    {
      "id": "d15",
      "from": 20,
      "to": 20,
      "text": "黑色古书不太明白眼前这只狐狐为什么要突然用怪异手法薅她自己的尾巴。",
      "channel": "narrator",
      "mode": "assertion",
      "holder": null,
      "about": [
        "MercuryCodex",
        "SuTianqing",
        "FoxBody"
      ]
    },
    {
      "id": "d16",
      "from": 21,
      "to": 21,
      "text": "古书心想这样不疼吗。",
      "channel": "thought",
      "mode": "question",
      "holder": "MercuryCodex",
      "about": [
        "SuTianqing",
        "FoxBody"
      ]
    },
    {
      "id": "d17",
      "from": 22,
      "to": 22,
      "text": "苏天晴干咳两声，让古书稍等一下。",
      "channel": "speech",
      "mode": "request",
      "holder": "SuTianqing",
      "about": [
        "MercuryCodex"
      ]
    },
    {
      "id": "d18",
      "from": 23,
      "to": 23,
      "text": "苏天晴掩饰尴尬、阻止古书继续说话，并飞快理清思绪。",
      "channel": "narrator",
      "mode": "assertion",
      "holder": null,
      "about": [
        "SuTianqing",
        "MercuryCodex"
      ]
    },
    {
      "id": "d19",
      "from": 24,
      "to": 24,
      "text": "苏天晴认为自己重生了。",
      "channel": "thought",
      "mode": "assertion",
      "holder": "SuTianqing",
      "about": [
        "SuTianqing"
      ]
    },
    {
      "id": "d20",
      "from": 25,
      "to": 25,
      "text": "苏天晴认为自己重生成了金毛狐女。",
      "channel": "thought",
      "mode": "assertion",
      "holder": "SuTianqing",
      "about": [
        "SuTianqing",
        "FoxBody"
      ]
    },
    {
      "id": "d21",
      "from": 26,
      "to": 26,
      "text": "苏天晴疑惑眼前这本黑色会说话的书是什么，并希望能有人解释。",
      "channel": "thought",
      "mode": "question",
      "holder": "SuTianqing",
      "about": [
        "MercuryCodex",
        "SuTianqing"
      ]
    },
    {
      "id": "d22",
      "from": 27,
      "to": 27,
      "text": "苏天晴问古书是谁。",
      "channel": "speech",
      "mode": "question",
      "holder": "SuTianqing",
      "about": [
        "MercuryCodex"
      ]
    },
    {
      "id": "d23",
      "from": 28,
      "to": 28,
      "text": "古书沉默思考这只呆头呆脑的狐狐是否是自己要找的人，随后重复开场白。",
      "channel": "narrator",
      "mode": "assertion",
      "holder": null,
      "about": [
        "MercuryCodex",
        "SuTianqing"
      ]
    },
    {
      "id": "d24",
      "from": 29,
      "to": 29,
      "text": "古书自称墨丘利秘典，从星空彼岸远行至此，前来寻找最优秀的适格者。",
      "channel": "voice",
      "mode": "assertion",
      "holder": "MercuryCodex",
      "about": [
        "MercuryCodex"
      ]
    },
    {
      "id": "d25",
      "from": 30,
      "to": 30,
      "text": "古书称那个人就是苏天晴。",
      "channel": "voice",
      "mode": "assertion",
      "holder": "MercuryCodex",
      "about": [
        "SuTianqing"
      ]
    },
    {
      "id": "d26",
      "from": 31,
      "to": 31,
      "text": "苏天晴听完后陷入沉默与思索。",
      "channel": "narrator",
      "mode": "assertion",
      "holder": null,
      "about": [
        "SuTianqing"
      ]
    },
    {
      "id": "d27",
      "from": 32,
      "to": 32,
      "text": "苏天晴从床上蹦下，走到落地镜前，沉默看向镜中穿宽松睡裙的娇小身影。",
      "channel": "narrator",
      "mode": "assertion",
      "holder": null,
      "about": [
        "SuTianqing",
        "FoxBody"
      ]
    },
    {
      "id": "d28",
      "from": 33,
      "to": 33,
      "text": "苏天晴抬起一只脚，欣赏白皙软嫩带红晕的小脚。",
      "channel": "narrator",
      "mode": "assertion",
      "holder": null,
      "about": [
        "SuTianqing",
        "FoxBody"
      ]
    },
    {
      "id": "d29",
      "from": 34,
      "to": 34,
      "text": "苏天晴认为脚完美、绝品。",
      "channel": "thought",
      "mode": "assertion",
      "holder": "SuTianqing",
      "about": [
        "FoxBody"
      ]
    },
    {
      "id": "d30",
      "from": 35,
      "to": 35,
      "text": "古书说看来苏天晴对现在的身体很满意。",
      "channel": "voice",
      "mode": "assertion",
      "holder": "MercuryCodex",
      "about": [
        "SuTianqing",
        "FoxBody"
      ]
    },
    {
      "id": "d31",
      "from": 37,
      "to": 37,
      "text": "古书问苏天晴为什么盯着脚看，正常情况下不应该是这样。",
      "channel": "voice",
      "mode": "question",
      "holder": "MercuryCodex",
      "about": [
        "SuTianqing",
        "FoxBody"
      ]
    },
    {
      "id": "d32",
      "from": 38,
      "to": 38,
      "text": "苏天晴说小脚才是世界上最美好的瑰宝，吃饭时看见都能多炫两碗。",
      "channel": "speech",
      "mode": "assertion",
      "holder": "SuTianqing",
      "about": [
        "FoxBody"
      ]
    },
    {
      "id": "d33",
      "from": 39,
      "to": 39,
      "text": "苏天晴嘴上回答古书，脑中对现状有了大致了解。",
      "channel": "narrator",
      "mode": "assertion",
      "holder": null,
      "about": [
        "SuTianqing",
        "MercuryCodex"
      ]
    },
    {
      "id": "d34",
      "from": 40,
      "to": 40,
      "text": "苏天晴意识到这本书知道自己并不是这副身体原来的主人。",
      "channel": "thought",
      "mode": "conjecture",
      "holder": "SuTianqing",
      "about": [
        "MercuryCodex",
        "OriginalOwner",
        "SuTianqing",
        "FoxBody"
      ]
    },
    {
      "id": "d35",
      "from": 41,
      "to": 41,
      "text": "古书说既然苏天晴满意，就可以直接快进到下个步骤。",
      "channel": "voice",
      "mode": "assertion",
      "holder": "MercuryCodex",
      "about": [
        "SuTianqing"
      ]
    },
    {
      "id": "d36",
      "from": 43,
      "to": 43,
      "text": "古书让苏天晴听着。",
      "channel": "voice",
      "mode": "request",
      "holder": "MercuryCodex",
      "about": [
        "SuTianqing"
      ]
    },
    {
      "id": "d37",
      "from": 44,
      "to": 44,
      "text": "古书称苏天晴是墨丘利秘典的最佳适格者，作为星界使者会引导她走上完美生活，而她只需与古书签订一个小小契约。",
      "channel": "voice",
      "mode": "promise",
      "holder": "MercuryCodex",
      "about": [
        "SuTianqing",
        "MercuryCodex"
      ]
    },
    {
      "id": "d38",
      "from": 45,
      "to": 45,
      "text": "苏天晴立刻答应签约。",
      "channel": "speech",
      "mode": "assertion",
      "holder": "SuTianqing",
      "about": [
        "SuTianqing",
        "MercuryCodex"
      ]
    },
    {
      "id": "d39",
      "from": 46,
      "to": 46,
      "text": "古书对苏天晴立刻答应感到意外。",
      "channel": "voice",
      "mode": "question",
      "holder": "MercuryCodex",
      "about": [
        "SuTianqing"
      ]
    },
    {
      "id": "d40",
      "from": 48,
      "to": 48,
      "text": "古书说苏天晴不按套路出牌，契约不该说签就签，都不犹豫考虑。",
      "channel": "voice",
      "mode": "question",
      "holder": "MercuryCodex",
      "about": [
        "SuTianqing"
      ]
    },
    {
      "id": "d41",
      "from": 49,
      "to": 49,
      "text": "苏天晴说古书思想狭隘，并称其为小破书。",
      "channel": "speech",
      "mode": "assertion",
      "holder": "SuTianqing",
      "about": [
        "MercuryCodex"
      ]
    },
    {
      "id": "d42",
      "from": 50,
      "to": 50,
      "text": "苏天晴问古书世界上最通用的愿望是哪两个。",
      "channel": "speech",
      "mode": "question",
      "holder": "SuTianqing",
      "about": [
        "MercuryCodex"
      ]
    },
    {
      "id": "d43",
      "from": 51,
      "to": 51,
      "text": "古书反问是哪两个。",
      "channel": "voice",
      "mode": "question",
      "holder": "MercuryCodex",
      "about": [
        "SuTianqing"
      ]
    },
    {
      "id": "d44",
      "from": 53,
      "to": 53,
      "text": "苏天晴说取之不尽的财富以及变成萝莉是世界上最通用的两个愿望。",
      "channel": "speech",
      "mode": "assertion",
      "holder": "SuTianqing",
      "about": [
        "SuTianqing"
      ]
    },
    {
      "id": "d45",
      "from": 55,
      "to": 55,
      "text": "苏天晴说变成萝莉本身就是最大的奖励，更何况还是这样一只可爱的狐狐。",
      "channel": "speech",
      "mode": "assertion",
      "holder": "SuTianqing",
      "about": [
        "SuTianqing",
        "FoxBody"
      ]
    },
    {
      "id": "d46",
      "from": 57,
      "to": 57,
      "text": "古书觉得好像有哪里很对又根本不对，但迅速把话题拖回正题。",
      "channel": "narrator",
      "mode": "assertion",
      "holder": null,
      "about": [
        "MercuryCodex"
      ]
    },
    {
      "id": "d47",
      "from": 58,
      "to": 58,
      "text": "古书问既然苏天晴答应，两者之间的契约就算成立。",
      "channel": "voice",
      "mode": "question",
      "holder": "MercuryCodex",
      "about": [
        "SuTianqing",
        "MercuryCodex"
      ]
    },
    {
      "id": "d48",
      "from": 59,
      "to": 59,
      "text": "苏天晴不假思索地说成立。",
      "channel": "speech",
      "mode": "assertion",
      "holder": "SuTianqing",
      "about": [
        "SuTianqing",
        "MercuryCodex"
      ]
    },
    {
      "id": "d49",
      "from": 61,
      "to": 61,
      "text": "苏天晴问能否询问契约的具体内容。",
      "channel": "speech",
      "mode": "question",
      "holder": "SuTianqing",
      "about": [
        "SuTianqing",
        "MercuryCodex"
      ]
    },
    {
      "id": "d50",
      "from": 62,
      "to": 62,
      "text": "苏天晴担心契约是奇怪的奴隶契约，那样就亏大了。",
      "channel": "thought",
      "mode": "conjecture",
      "holder": "SuTianqing",
      "about": [
        "SuTianqing"
      ]
    },
    {
      "id": "d51",
      "from": 63,
      "to": 63,
      "text": "古书说契约内容是反派魔法少女。",
      "channel": "voice",
      "mode": "assertion",
      "holder": "MercuryCodex",
      "about": [
        "SuTianqing"
      ]
    },
    {
      "id": "d52",
      "from": 66,
      "to": 66,
      "text": "古书说契约已签订，从今天开始苏天晴将成为魔法少女活跃于世，造物主为她量身定制了一整套任务，能帮助她逐步走上反派魔法少女的顶点。",
      "channel": "voice",
      "mode": "assertion",
      "holder": "MercuryCodex",
      "about": [
        "SuTianqing",
        "Creator"
      ]
    },
    {
      "id": "d53",
      "from": 67,
      "to": 67,
      "text": "苏天晴质问魔法少女是怎么回事，是不是死亡率高达90%的高危职业。",
      "channel": "speech",
      "mode": "question",
      "holder": "SuTianqing",
      "about": [
        "SuTianqing"
      ]
    },
    {
      "id": "d54",
      "from": 68,
      "to": 68,
      "text": "古书让苏天晴放心，说是王道系的那种。",
      "channel": "voice",
      "mode": "assertion",
      "holder": "MercuryCodex",
      "about": [
        "SuTianqing"
      ]
    },
    {
      "id": "d55",
      "from": 69,
      "to": 69,
      "text": "苏天晴说正因为是王道故事，当反派才是纯纯找死。",
      "channel": "speech",
      "mode": "assertion",
      "holder": "SuTianqing",
      "about": [
        "SuTianqing"
      ]
    },
    {
      "id": "d56",
      "from": 70,
      "to": 70,
      "text": "苏天晴突然有点后悔。",
      "channel": "narrator",
      "mode": "assertion",
      "holder": null,
      "about": [
        "SuTianqing"
      ]
    },
    {
      "id": "d57",
      "from": 71,
      "to": 71,
      "text": "苏天晴想王道系是魔法少女们面对强敌逐渐成长，喊着友情和羁绊把反派干碎；即使反派有系统有任务也很难在王道系故事里把主角干碎。",
      "channel": "thought",
      "mode": "assertion",
      "holder": "SuTianqing",
      "about": [
        "SuTianqing"
      ]
    },
    {
      "id": "d58",
      "from": 72,
      "to": 72,
      "text": "苏天晴心想自己还有没有反悔机会，能否被送回原来的身体，觉得急性心肌梗死还有抢救机会。",
      "channel": "thought",
      "mode": "question",
      "holder": "SuTianqing",
      "about": [
        "SuTianqing"
      ]
    },
    {
      "id": "d59",
      "from": 73,
      "to": 73,
      "text": "墨丘利秘典绑定成功。",
      "channel": "in-world-system",
      "mode": "assertion",
      "holder": "MercuryCodex",
      "about": [
        "MercuryCodex",
        "SuTianqing"
      ]
    },
    {
      "id": "d60",
      "from": 74,
      "to": 74,
      "text": "脑子里响起的声音让苏天晴欲哭无泪。",
      "channel": "narrator",
      "mode": "assertion",
      "holder": null,
      "about": [
        "SuTianqing",
        "MercuryCodex"
      ]
    },
    {
      "id": "d61",
      "from": 75,
      "to": 75,
      "text": "契约成立。",
      "channel": "in-world-system",
      "mode": "assertion",
      "holder": "MercuryCodex",
      "about": [
        "SuTianqing",
        "MercuryCodex"
      ]
    },
    {
      "id": "d62",
      "from": 76,
      "to": 76,
      "text": "古书让苏天晴走上反派魔法少女的道路。",
      "channel": "voice",
      "mode": "request",
      "holder": "MercuryCodex",
      "about": [
        "SuTianqing"
      ]
    }
  ],
