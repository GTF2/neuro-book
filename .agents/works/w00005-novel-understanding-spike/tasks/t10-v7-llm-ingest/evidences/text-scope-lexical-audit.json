  "commands": "@'\nimport {readFileSync} from 'node:fs';\nimport {createQueryIndex,querySnapshot} from '../t07-v7-schema-gold/index.ts';\nimport {createRecordPresenter} from '../t09-v7-query-cli/content.ts';\nconst results=[];\nfor(const path of ['evidences/formal-003/ch03/dataset-v7.json','evidences/smoke-007/ch01/dataset-v7.json']) {\n const dataset=JSON.parse(readFileSync(path,'utf8')); const index=createQueryIndex(dataset);\n const names=[...new Set(dataset.nodes.filter(n=>n.kind==='entity').flatMap(n=>n.data.names.map(a=>a.text)))].filter(t=>[...t].length>=2);\n const sourcePositions=dataset.sources.flatMap(source=>source.paragraphs.map((text,i)=>({text,at:{chapter:source.chapterOrder,paragraph:i+1}})));\n const checks=[]; const cache=new Map();\n for(const term of names) {\n  const first=sourcePositions.findIndex(p=>p.text.includes(term));\n  if(first<=0) { checks.push({term,status:first<0?'not-exact-in-source':'first-source-paragraph'}); continue; }\n  const at=sourcePositions[first-1].at; const key=JSON.stringify(at);\n  if(!cache.has(key)) {\n   const scope={readAt:at,perspective:'reader',world:'original'};\n   const projected=querySnapshot(index,scope); const presenter=createRecordPresenter(dataset,scope,projected.nodes);\n   cache.set(key,projected.nodes.map(node=>presenter.present(node)));\n  }\n  const items=cache.get(key),hits=[];\n  for(const item of items) {\n   function scan(value,field) {\n    if(typeof value==='string' && value.includes(term)) hits.push({id:item.record.id,kind:item.record.kind,field,text:value});\n    else if(Array.isArray(value)) value.forEach((part,i)=>scan(part,`${field}[${i}]`));\n    else if(value && typeof value==='object') for(const [key,part] of Object.entries(value)) scan(part,`${field}.${key}`);\n   }\n   scan(item,'item');\n  }\n  checks.push({term,firstSourceAt:sourcePositions[first].at,readAt:at,scannedRecords:items.length,hits});\n }\n results.push({path,entityNames:names.length,checks});\n}\nconsole.log(JSON.stringify({schema:'neurobook.memory.readonly-lexical-scope-audit.v1',limitation:'Exact source-name strings only; findings require semantic review and absence is not general spoiler-safety proof.',results}));\n'@ | node --import tsx --input-type=module -",
