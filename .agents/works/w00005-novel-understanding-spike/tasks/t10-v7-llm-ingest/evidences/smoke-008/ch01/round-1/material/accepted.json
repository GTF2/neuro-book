  "disclosures": [
    {
      "id": "D1",
      "from": 4,
      "to": 4,
      "text": "一个低沉声音要求给出姓名。",
      "channel": "voice",
      "mode": "request",
      "holder": null,
      "about": []
    },
    {
      "id": "D2",
      "from": 5,
      "to": 5,
      "text": "苏天晴回答自己的姓名是苏天晴。",
      "channel": "speech",
      "mode": "assertion",
      "holder": "SuTianqing",
      "about": [
        "SuTianqing"
      ]
    },
    {
      "id": "D3",
      "from": 7,
      "to": 11,
      "text": "苏天晴在昏暗房间坐在床头，看着飘浮在半空中的黑色古书，并从落地镜中瞥见自己已成为一只陌生的娇小金毛狐女，拥有金色长发、狐耳和炸毛大尾巴。",
      "channel": "narrator",
      "mode": "assertion",
      "holder": null,
      "about": [
        "SuTianqing",
        "MoQiulMidian"
      ]
    },
    {
      "id": "D4",
      "from": 13,
      "to": 15,
      "text": "苏天晴被古书的声音拉回注意力；她回忆起五分钟前自己连续三个夜班后刚下班，在街边面摊吃加煎蛋的牛肉面，听到太奶在背后说话，回头看见太奶坐在藤椅上编围巾，随后胸口一疼眼前一黑。",
      "channel": "thought",
      "mode": "assertion",
      "holder": "SuTianqing",
      "about": [
        "SuTianqing",
        "MoQiulMidian",
        "TaiNai"
      ]
    },
    {
      "id": "D5",
      "from": 16,
      "to": 18,
      "text": "苏天晴伸手用力薅自己炸毛的大尾巴，感受到柔顺触感以及从尾巴尖直冲天灵盖的陌生摩挲拉拽感，惊得两只耳朵竖起、整只狐绷直身体；她确认触感非常真实。",
      "channel": "thought",
      "mode": "assertion",
      "holder": "SuTianqing",
      "about": [
        "SuTianqing"
      ]
    },
    {
      "id": "D6",
      "from": 19,
      "to": 21,
      "text": "黑色古书不明白苏天晴为何突然用怪异手法薅自己的尾巴，并疑惑她不疼吗。",
      "channel": "thought",
      "mode": "question",
      "holder": "MoQiulMidian",
      "about": [
        "MoQiulMidian",
        "SuTianqing"
      ]
    },
    {
      "id": "D7",
      "from": 23,
      "to": 25,
      "text": "苏天晴阻止古书继续说话，理清思绪，认识到自己重生了，并重生成了一只金毛狐女。",
      "channel": "thought",
      "mode": "assertion",
      "holder": "SuTianqing",
      "about": [
        "SuTianqing"
      ]
    },
    {
      "id": "D8",
      "from": 26,
      "to": 26,
      "text": "苏天晴疑惑眼前这本会说话的黑色古书是怎么回事，并希望有人解释。",
      "channel": "thought",
      "mode": "question",
      "holder": "SuTianqing",
      "about": [
        "SuTianqing",
        "MoQiulMidian"
      ]
    },
    {
      "id": "D9",
      "from": 27,
      "to": 27,
      "text": "苏天晴问古书是谁。",
      "channel": "speech",
      "mode": "question",
      "holder": "SuTianqing",
      "about": [
        "SuTianqing",
        "MoQiulMidian"
      ]
    },
    {
      "id": "D10",
      "from": 28,
      "to": 30,
      "text": "墨丘利秘典自称从星空彼岸远行至此，前来寻找自己最优秀的适格者，并称那个人就是苏天晴小姐。",
      "channel": "speech",
      "mode": "assertion",
      "holder": "MoQiulMidian",
      "about": [
        "MoQiulMidian",
        "SuTianqing"
      ]
    },
    {
      "id": "D11",
      "from": 32,
      "to": 34,
      "text": "苏天晴跳下床到落地镜前，沉默看向镜中穿宽松睡裙的娇小身影，并抬脚欣赏自己白皙软嫩带红晕的小脚，认为完美绝品。",
      "channel": "thought",
      "mode": "assertion",
      "holder": "SuTianqing",
      "about": [
        "SuTianqing"
      ]
    },
    {
      "id": "D12",
      "from": 35,
      "to": 37,
      "text": "古书注意到苏天晴认真欣赏脚丫，语塞后说她似乎对现在的身体很满意，并问她为什么要盯着脚看。",
      "channel": "speech",
      "mode": "question",
      "holder": "MoQiulMidian",
      "about": [
        "MoQiulMidian",
        "SuTianqing"
      ]
    },
    {
      "id": "D13",
      "from": 38,
      "to": 38,
      "text": "苏天晴说小脚是世界上最美好的瑰宝，吃饭时看见能多炫两碗。",
      "channel": "speech",
      "mode": "assertion",
      "holder": "SuTianqing",
      "about": [
        "SuTianqing"
      ]
    },
    {
      "id": "D14",
      "from": 39,
      "to": 40,
      "text": "苏天晴对现状有了大概了解，推测这本古书知道她并不是这副身体原来的主人，并思考难道说……",
      "channel": "thought",
      "mode": "conjecture",
      "holder": "SuTianqing",
      "about": [
        "SuTianqing",
        "MoQiulMidian",
        "OriginalBodyOwner"
      ]
    },
    {
      "id": "D15",
      "from": 41,
      "to": 42,
      "text": "古书表示既然苏天晴满意，就可以直接快进到下个步骤，并把她的注意力唤回。",
      "channel": "speech",
      "mode": "assertion",
      "holder": "MoQiulMidian",
      "about": [
        "MoQiulMidian",
        "SuTianqing"
      ]
    },
    {
      "id": "D16",
      "from": 43,
      "to": 44,
      "text": "墨丘利秘典称苏天晴是它的最佳适格者，作为星界使者会引导她走上完美的生活，而她只需与它签订一个小小的契约。",
      "channel": "speech",
      "mode": "promise",
      "holder": "MoQiulMidian",
      "about": [
        "MoQiulMidian",
        "SuTianqing"
      ]
    },
    {
      "id": "D17",
      "from": 45,
      "to": 45,
      "text": "苏天晴立刻答应签订契约。",
      "channel": "speech",
      "mode": "promise",
      "holder": "SuTianqing",
      "about": [
        "SuTianqing",
        "MoQiulMidian"
      ]
    },
    {
      "id": "D18",
      "from": 46,
      "to": 48,
      "text": "古书惊讶苏天晴不按套路出牌，契约说签就签，不犹豫考虑。",
      "channel": "speech",
      "mode": "question",
      "holder": "MoQiulMidian",
      "about": [
        "MoQiulMidian",
        "SuTianqing"
      ]
    },
    {
      "id": "D19",
      "from": 49,
      "to": 50,
      "text": "苏天晴严肃地说古书思想狭隘，并问它世界上最通用的愿望是哪两个。",
      "channel": "speech",
      "mode": "question",
      "holder": "SuTianqing",
      "about": [
        "SuTianqing",
        "MoQiulMidian"
      ]
    },
    {
      "id": "D20",
      "from": 51,
      "to": 55,
      "text": "苏天晴提出世界上最通用的两个愿望是取之不尽的财富和变成萝莉，并认为变成萝莉本身就是最大的奖励，更何况现在是这样一只可爱的狐狐。",
      "channel": "speech",
      "mode": "assertion",
      "holder": "SuTianqing",
      "about": [
        "SuTianqing"
      ]
    },
    {
      "id": "D21",
      "from": 58,
      "to": 58,
      "text": "墨丘利秘典问既然苏天晴答应，契约是否就算成立。",
      "channel": "speech",
      "mode": "question",
      "holder": "MoQiulMidian",
      "about": [
        "MoQiulMidian",
        "SuTianqing"
      ]
    },
    {
      "id": "D22",
      "from": 59,
      "to": 59,
      "text": "苏天晴确认契约成立。",
      "channel": "speech",
      "mode": "assertion",
      "holder": "SuTianqing",
      "about": [
        "SuTianqing",
        "MoQiulMidian"
      ]
    },
    {
      "id": "D23",
      "from": 61,
      "to": 61,
      "text": "苏天晴询问契约的具体内容。",
      "channel": "speech",
      "mode": "question",
      "holder": "SuTianqing",
      "about": [
        "SuTianqing",
        "MoQiulMidian"
      ]
    },
    {
      "id": "D24",
      "from": 62,
      "to": 62,
      "text": "苏天晴担心契约可能是奇怪的奴隶契约，那样就亏大了。",
      "channel": "thought",
      "mode": "conjecture",
      "holder": "SuTianqing",
      "about": [
        "SuTianqing"
      ]
    },
    {
      "id": "D25",
      "from": 63,
      "to": 64,
      "text": "墨丘利秘典回答契约内容是反派魔法少女。",
      "channel": "speech",
      "mode": "assertion",
      "holder": "MoQiulMidian",
      "about": [
        "MoQiulMidian",
        "SuTianqing"
      ]
    },
    {
      "id": "D26",
      "from": 65,
      "to": 66,
      "text": "墨丘利秘典宣布契约已签订，从今天起苏天晴将成为魔法少女活跃于世；造物主为她量身定制了一整套任务，能帮助她逐步走上反派魔法少女的顶点。",
      "channel": "speech",
      "mode": "assertion",
      "holder": "MoQiulMidian",
      "about": [
        "MoQiulMidian",
        "SuTianqing",
        "Creator"
      ]
    },
    {
      "id": "D27",
      "from": 67,
      "to": 67,
      "text": "苏天晴震惊质问魔法少女是怎么回事，是否是死亡率高达90%的高危职业。",
      "channel": "speech",
      "mode": "question",
      "holder": "SuTianqing",
      "about": [
        "SuTianqing"
      ]
    },
    {
      "id": "D28",
      "from": 68,
      "to": 68,
      "text": "墨丘利秘典说放心吧，是王道系的那种。",
      "channel": "speech",
      "mode": "assertion",
      "holder": "MoQiulMidian",
      "about": [
        "MoQiulMidian"
      ]
    },
    {
      "id": "D29",
      "from": 69,
      "to": 69,
      "text": "苏天晴认为在王道故事里当反派纯粹是找死。",
      "channel": "speech",
      "mode": "assertion",
      "holder": "SuTianqing",
      "about": [
        "SuTianqing"
      ]
    },
    {
      "id": "D30",
      "from": 70,
      "to": 72,
      "text": "苏天晴后悔签订契约，认为王道系故事中魔法少女会面对强敌成长，喊着友情和羁绊击败反派；即便反派有系统和任务也难获胜。她希望有反悔机会，把自己送回原来的身体，觉得急性心肌梗死还有抢救机会。",
      "channel": "thought",
      "mode": "conjecture",
      "holder": "SuTianqing",
      "about": [
        "SuTianqing"
      ]
    },
    {
      "id": "D31",
      "from": 73,
      "to": 75,
      "text": "墨丘利秘典提示绑定成功，契约成立。",
      "channel": "in-world-system",
      "mode": "assertion",
      "holder": "MoQiulMidian",
      "about": [
        "MoQiulMidian",
        "SuTianqing"
      ]
    },
    {
      "id": "D32",
      "from": 76,
      "to": 76,
      "text": "墨丘利秘典要求苏天晴走上反派魔法少女的道路。",
      "channel": "in-world-system",
      "mode": "request",
      "holder": "MoQiulMidian",
      "about": [
        "MoQiulMidian",
        "SuTianqing"
      ]
    }
  ],
