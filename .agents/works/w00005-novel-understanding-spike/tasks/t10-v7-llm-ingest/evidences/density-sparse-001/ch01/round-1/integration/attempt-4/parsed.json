  "summaries": [
    {
      "id": "sum_su",
      "entity": "su_tianqing",
      "facet": "重生、契约与处境",
      "items": [
        {
          "text": "苏天晴（原为连续夜班后死亡的现代人）在昏暗房间醒来，意识到自己重生为一只金毛狐女；她推测墨丘利秘典知道她不是这具身体原来的主人。",
          "refs": [
            "d5",
            "d12",
            "b4",
            "b7"
          ]
        },
        {
          "text": "她与墨丘利秘典签约；古书称契约内容是‘反派魔法少女’，并称造物主为她量身定制了走向反派魔法少女顶点的任务。",
          "refs": [
            "d15",
            "d24",
            "d25"
          ]
        },
        {
          "text": "得知魔法少女是王道系后，她后悔并想反悔、被送回原来的身体。",
          "refs": [
            "d27",
            "d29"
          ]
        }
      ]
    },
    {
      "id": "sum_mercury",
      "entity": "mercury_tome",
      "facet": "自称身份与契约行为",
      "items": [
        {
          "text": "以飘浮的黑色古书形态出现并联接苏天晴的意识。",
          "refs": [
            "b3",
            "b5"
          ]
        },
        {
          "text": "自称墨丘利秘典，从星空彼岸远行而来，寻找最优秀的适格者，并认定苏天晴就是那个人。",
          "refs": [
            "d8",
            "d9"
          ]
        },
        {
          "text": "作为星界使者提出与苏天晴签约、引导她走上完美生活；后宣告墨丘利秘典绑定成功、契约成立，并让她走上反派魔法少女道路。",
          "refs": [
            "d14",
            "d30",
            "d31"
          ]
        }
      ]
    },
    {
      "id": "sum_fox_body",
      "entity": "fox_body",
      "facet": "外观与归属",
      "items": [
        {
          "text": "镜中呈现金发、毛茸茸耳朵、炸毛大尾巴的娇小狐女，肌肤白皙，身穿宽松睡裙。",
          "refs": [
            "b4",
            "b7",
            "b11"
          ]
        },
        {
          "text": "苏天晴认为这不是她原来的身体，原主人身份/下落不明。",
          "refs": [
            "d12"
          ]
        }
      ]
    },
    {
