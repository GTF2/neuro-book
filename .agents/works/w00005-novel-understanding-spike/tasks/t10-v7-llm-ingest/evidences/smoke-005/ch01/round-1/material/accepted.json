  "disclosures": [
    {
      "id": "d_001",
      "from": 2,
      "to": 2,
      "text": "本书出场角色均已满18岁，不存在任何未成年人！",
      "channel": "author",
      "mode": "assertion",
      "holder": null,
      "about": []
    },
    {
      "id": "d_002",
      "from": 4,
      "to": 4,
      "text": "一个声音询问姓名。",
      "channel": "voice",
      "mode": "request",
      "holder": null,
      "about": []
    },
    {
      "id": "d_003",
      "from": 5,
      "to": 5,
      "text": "苏天晴回答自己的姓名为“苏天晴”。",
      "channel": "speech",
      "mode": "assertion",
      "holder": "r_stq",
      "about": [
        "r_stq"
      ]
    },
    {
      "id": "d_004",
      "from": 6,
      "to": 6,
      "text": "昏暗的房间里传出清脆悦耳的女声，还有一道仿佛来自遥远彼方的低沉言语。",
      "channel": "narrator",
      "mode": "assertion",
      "holder": null,
      "about": []
    },
    {
      "id": "d_005",
      "from": 7,
      "to": 7,
      "text": "苏天晴坐在床头，呆滞地看着飘浮在半空中的黑色古书，并从床边落地镜中瞥见一道陌生的娇小身影。",
      "channel": "narrator",
      "mode": "assertion",
      "holder": null,
      "about": [
        "r_stq",
        "r_moqiu",
        "r_gfb"
      ]
    },
    {
      "id": "d_006",
      "from": 8,
      "to": 8,
      "text": "镜中身影拥有灿烂金色长发、毛茸茸的耳朵和精致五官与眼眸。",
      "channel": "narrator",
      "mode": "assertion",
      "holder": null,
      "about": [
        "r_gfb"
      ]
    },
    {
      "id": "d_007",
      "from": 10,
      "to": 10,
      "text": "镜中身影是一只娇小的金毛狐女。",
      "channel": "narrator",
      "mode": "assertion",
      "holder": null,
      "about": [
        "r_gfb"
      ]
    },
    {
      "id": "d_008",
      "from": 12,
      "to": 12,
      "text": "古书发出“嗯嗯……这样啊……”的言语。",
      "channel": "voice",
      "mode": "assertion",
      "holder": "r_moqiu",
      "about": []
    },
    {
      "id": "d_009",
      "from": 13,
      "to": 13,
      "text": "房间中的低沉言语再次响起，将苏天晴的注意力拽回眼前这本黑色古书。",
      "channel": "narrator",
      "mode": "assertion",
      "holder": null,
      "about": [
        "r_stq",
        "r_moqiu"
      ]
    },
    {
      "id": "d_010",
      "from": 14,
      "to": 14,
      "text": "苏天晴有些茫然。",
      "channel": "thought",
      "mode": "assertion",
      "holder": "r_stq",
      "about": [
        "r_stq"
      ]
    },
    {
      "id": "d_011",
      "from": 15,
      "to": 15,
      "text": "苏天晴回忆：五分钟前她结束连续三个夜班下班后，在街边面摊吃加煎蛋的豪华牛肉面并加辣椒面，突然听到太奶在背后说话，回头看见太奶坐藤椅编围巾，随后胸口一疼、眼前一黑，就此死去。",
      "channel": "thought",
      "mode": "assertion",
      "holder": "r_stq",
      "about": [
        "r_stq",
        "r_great_grandma"
      ]
    },
    {
      "id": "d_012",
      "from": 16,
      "to": 16,
      "text": "苏天晴鬼使神差地伸手，在身侧摇曳的炸毛大尾巴上用力薅了一把。",
      "channel": "narrator",
      "mode": "assertion",
      "holder": null,
      "about": [
        "r_stq",
        "r_gfb"
      ]
    },
    {
      "id": "d_013",
      "from": 17,
      "to": 17,
      "text": "薅尾巴带来无比柔顺的触感，同时一股摩挲拉拽感从尾巴尖直冲天灵盖，惊得两只耳朵竖起，整只狐绷直了身体。",
      "channel": "narrator",
      "mode": "assertion",
      "holder": null,
      "about": [
        "r_stq",
        "r_gfb"
      ]
    },
    {
      "id": "d_014",
      "from": 18,
      "to": 18,
      "text": "好真实的触感！",
      "channel": "thought",
      "mode": "assertion",
      "holder": "r_stq",
      "about": [
        "r_gfb"
      ]
    },
    {
      "id": "d_015",
      "from": 19,
      "to": 19,
      "text": "古书问：“……你干嘛呢。”",
      "channel": "voice",
      "mode": "question",
      "holder": "r_moqiu",
      "about": [
        "r_stq"
      ]
    },
    {
      "id": "d_016",
      "from": 20,
      "to": 20,
      "text": "黑色古书发出低沉的言语，不太明白眼前这只狐狐为什么要突然用怪异的手法去薅她自己的尾巴。",
      "channel": "narrator",
      "mode": "assertion",
      "holder": null,
      "about": [
        "r_moqiu",
        "r_stq",
        "r_gfb"
      ]
    },
    {
      "id": "d_017",
      "from": 21,
      "to": 21,
      "text": "古书心想：不疼的吗？",
      "channel": "thought",
      "mode": "question",
      "holder": "r_moqiu",
      "about": [
        "r_stq"
      ]
    },
    {
      "id": "d_018",
      "from": 22,
      "to": 22,
      "text": "苏天晴干咳两声说：“咳咳！等一下，稍等一下！”",
      "channel": "speech",
      "mode": "request",
      "holder": "r_stq",
      "about": [
        "r_moqiu"
      ]
    },
    {
      "id": "d_019",
      "from": 23,
      "to": 23,
      "text": "苏天晴伸手阻止古书继续说话，眼珠一转，飞快地厘清思绪。",
      "channel": "narrator",
      "mode": "assertion",
      "holder": null,
      "about": [
        "r_stq",
        "r_moqiu"
      ]
    },
    {
      "id": "d_020",
      "from": 24,
      "to": 24,
      "text": "苏天晴心想：我重生了。",
      "channel": "thought",
      "mode": "assertion",
      "holder": "r_stq",
      "about": [
        "r_stq"
      ]
    },
    {
      "id": "d_021",
      "from": 25,
      "to": 25,
      "text": "苏天晴心想：重生成了一只金毛狐女。",
      "channel": "thought",
      "mode": "assertion",
      "holder": "r_stq",
      "about": [
        "r_stq",
        "r_gfb"
      ]
    },
    {
      "id": "d_022",
      "from": 26,
      "to": 26,
      "text": "苏天晴心想：眼前这本黑色会说话的书是怎么回事？有人能给我解释一下吗？",
      "channel": "thought",
      "mode": "question",
      "holder": "r_stq",
      "about": [
        "r_moqiu"
      ]
    },
    {
      "id": "d_023",
      "from": 27,
      "to": 27,
      "text": "苏天晴问古书：“你是谁？”",
      "channel": "speech",
      "mode": "question",
      "holder": "r_stq",
      "about": [
        "r_moqiu"
      ]
    },
    {
      "id": "d_024",
      "from": 28,
      "to": 28,
      "text": "古书沉默一会儿后，重复了一遍两分钟前的开场白。",
      "channel": "narrator",
      "mode": "assertion",
      "holder": null,
      "about": [
        "r_moqiu",
        "r_stq"
      ]
    },
    {
      "id": "d_025",
      "from": 29,
      "to": 29,
      "text": "古书说：吾名墨丘利秘典，从星空彼岸远行至此，前来寻找我最优秀的适格者。",
      "channel": "voice",
      "mode": "assertion",
      "holder": "r_moqiu",
      "about": [
        "r_moqiu"
      ]
    },
    {
      "id": "d_026",
      "from": 30,
      "to": 30,
      "text": "古书对苏天晴说：而那个人就是你，苏天晴小姐。",
      "channel": "voice",
      "mode": "assertion",
      "holder": "r_moqiu",
      "about": [
        "r_stq"
      ]
    },
    {
      "id": "d_027",
      "from": 31,
      "to": 31,
      "text": "苏天晴再次听完中二台词后，又陷入沉默与思索。",
      "channel": "thought",
      "mode": "assertion",
      "holder": "r_stq",
      "about": [
        "r_stq",
        "r_moqiu"
      ]
    },
    {
      "id": "d_028",
      "from": 32,
      "to": 32,
      "text": "苏天晴从床上蹦下，走到落地镜前，沉默地看向镜中穿着宽松睡裙的娇小身影。",
      "channel": "narrator",
      "mode": "assertion",
      "holder": null,
      "about": [
        "r_stq",
        "r_gfb"
      ]
    },
    {
      "id": "d_029",
      "from": 33,
      "to": 33,
      "text": "苏天晴抬起一只脚，认真欣赏这只白皙软嫩带着红晕的小脚。",
      "channel": "narrator",
      "mode": "assertion",
      "holder": null,
      "about": [
        "r_stq",
        "r_gfb"
      ]
    },
    {
      "id": "d_030",
      "from": 34,
      "to": 34,
      "text": "苏天晴心想：嗯，完美，绝品。",
      "channel": "thought",
      "mode": "assertion",
      "holder": "r_stq",
      "about": [
        "r_gfb"
      ]
    },
    {
      "id": "d_031",
      "from": 35,
      "to": 35,
      "text": "古书说：看来你对现在的身体很满意嘛。",
      "channel": "voice",
      "mode": "assertion",
      "holder": "r_moqiu",
      "about": [
        "r_stq",
        "r_gfb"
      ]
    },
    {
      "id": "d_032",
      "from": 37,
      "to": 37,
      "text": "古书问：但是你为什么要盯着脚看？正常情况下不应该是……",
      "channel": "voice",
      "mode": "question",
      "holder": "r_moqiu",
      "about": [
        "r_stq"
      ]
    },
    {
      "id": "d_033",
      "from": 38,
      "to": 38,
      "text": "苏天晴说：你不懂，小脚才是世界上最美好的瑰宝，吃饭的时候看见了都能多炫两碗。",
      "channel": "speech",
      "mode": "assertion",
      "holder": "r_stq",
      "about": [
        "r_gfb"
      ]
    },
    {
      "id": "d_034",
      "from": 39,
      "to": 39,
      "text": "苏天晴嘴上回答古书，脑子里对现状有了个大概的了解。",
      "channel": "thought",
      "mode": "assertion",
      "holder": "r_stq",
      "about": [
        "r_stq",
        "r_moqiu"
      ]
    },
    {
      "id": "d_035",
      "from": 40,
      "to": 40,
      "text": "苏天晴猜想：这本书知道自己并不是这副身体原来的主人，难道说……",
      "channel": "thought",
      "mode": "conjecture",
      "holder": "r_stq",
      "about": [
        "r_moqiu",
        "r_original_owner"
      ]
    },
    {
      "id": "d_036",
      "from": 41,
      "to": 41,
      "text": "古书说：既然你这么满意，那咱们可以直接快进到下个步骤了。",
      "channel": "voice",
      "mode": "plan",
      "holder": "r_moqiu",
      "about": [
        "r_stq"
      ]
    },
    {
      "id": "d_037",
      "from": 43,
      "to": 43,
      "text": "古书说：听着，苏天晴。",
      "channel": "voice",
      "mode": "request",
      "holder": "r_moqiu",
      "about": [
        "r_stq"
      ]
    },
    {
      "id": "d_038",
      "from": 44,
      "to": 44,
      "text": "古书说：你是墨丘利秘典的最佳适格者，作为星界使者，我会引导你走上完美的生活，而你只需要与我签订一个小小的契约——",
      "channel": "voice",
      "mode": "promise",
      "holder": "r_moqiu",
      "about": [
        "r_stq",
        "r_moqiu"
      ]
    },
    {
      "id": "d_039",
      "from": 45,
      "to": 45,
      "text": "苏天晴说：好，我签。",
      "channel": "speech",
      "mode": "promise",
      "holder": "r_stq",
      "about": [
        "r_moqiu"
      ]
    },
    {
      "id": "d_040",
      "from": 48,
      "to": 48,
      "text": "古书问：不是，你不按套路出牌啊，契约怎么说签就签的？都不犹豫考虑一下吗？",
      "channel": "voice",
      "mode": "question",
      "holder": "r_moqiu",
      "about": [
        "r_stq"
      ]
    },
    {
      "id": "d_041",
      "from": 49,
      "to": 49,
      "text": "苏天晴说古书思想狭隘，并称其为小破书。",
      "channel": "speech",
      "mode": "assertion",
      "holder": "r_stq",
      "about": [
        "r_moqiu"
      ]
    },
    {
      "id": "d_042",
      "from": 50,
      "to": 50,
      "text": "苏天晴问：世界上最通用的愿望是哪两个？",
      "channel": "speech",
      "mode": "question",
      "holder": "r_stq",
      "about": []
    },
    {
      "id": "d_043",
      "from": 51,
      "to": 51,
      "text": "古书反问：哪两个？",
      "channel": "voice",
      "mode": "question",
      "holder": "r_moqiu",
      "about": []
    },
    {
      "id": "d_044",
      "from": 53,
      "to": 53,
      "text": "苏天晴说：取之不尽的财富！以及变成萝莉！这是世界上最通用的两个愿望！",
      "channel": "speech",
      "mode": "assertion",
      "holder": "r_stq",
      "about": []
    },
    {
      "id": "d_045",
      "from": 55,
      "to": 55,
      "text": "苏天晴说：变成萝莉本身就是最大的奖励，更何况还是这样一只可爱的狐狐！",
      "channel": "speech",
      "mode": "assertion",
      "holder": "r_stq",
      "about": [
        "r_gfb"
      ]
    },
    {
      "id": "d_046",
      "from": 57,
      "to": 57,
      "text": "古书并未因短时间错乱而呆愣太久，迅速将话题拖回正题。",
      "channel": "narrator",
      "mode": "assertion",
      "holder": null,
      "about": [
        "r_moqiu"
      ]
    },
    {
      "id": "d_047",
      "from": 58,
      "to": 58,
      "text": "古书问：既然你答应，那我们之间的契约就算成立了？",
      "channel": "voice",
      "mode": "question",
      "holder": "r_moqiu",
      "about": [
        "r_stq",
        "r_moqiu"
      ]
    },
    {
      "id": "d_048",
      "from": 59,
      "to": 59,
      "text": "苏天晴不假思索地说：成立。",
      "channel": "speech",
      "mode": "assertion",
      "holder": "r_stq",
      "about": [
        "r_moqiu"
      ]
    },
    {
      "id": "d_049",
      "from": 61,
      "to": 61,
      "text": "苏天晴问：那个……我能问问契约的具体内容吗？",
      "channel": "speech",
      "mode": "question",
      "holder": "r_stq",
      "about": [
        "r_moqiu"
      ]
    },
    {
      "id": "d_050",
      "from": 62,
      "to": 62,
      "text": "苏天晴心想：总不能是激活了什么奇怪的奴隶契约吧！那样的话可就亏大发了！",
      "channel": "thought",
      "mode": "conjecture",
      "holder": "r_stq",
      "about": [
        "r_moqiu"
      ]
    },
    {
      "id": "d_051",
      "from": 63,
      "to": 63,
      "text": "古书回答：反派魔法少女。",
      "channel": "voice",
      "mode": "assertion",
      "holder": "r_moqiu",
      "about": [
        "r_stq"
      ]
    },
    {
      "id": "d_052",
      "from": 66,
      "to": 66,
      "text": "古书说：既然契约已经签订，那么从今天开始，你就将成为魔法少女活跃于世，造物主给你量身定制了一整套任务，能帮助你逐步走上反派魔法少女的顶点！",
      "channel": "voice",
      "mode": "assertion",
      "holder": "r_moqiu",
      "about": [
        "r_stq"
      ]
    },
    {
      "id": "d_053",
      "from": 67,
      "to": 67,
      "text": "苏天晴问：不是、等一下！魔法少女是怎么回事！是那种死亡率高达90%的高危职业吗？！",
      "channel": "speech",
      "mode": "question",
      "holder": "r_stq",
      "about": []
    },
    {
      "id": "d_054",
      "from": 68,
      "to": 68,
      "text": "古书说：放心吧，是王道系的那种。",
      "channel": "voice",
      "mode": "assertion",
      "holder": "r_moqiu",
      "about": []
    },
    {
      "id": "d_055",
      "from": 69,
      "to": 69,
      "text": "苏天晴说：就是这样才不对吧！在王道故事里当反派不是纯纯的找死吗！",
      "channel": "speech",
      "mode": "denial",
      "holder": "r_stq",
      "about": []
    },
    {
      "id": "d_056",
      "from": 70,
      "to": 70,
      "text": "苏天晴突然有点后悔了。",
      "channel": "thought",
      "mode": "assertion",
      "holder": "r_stq",
      "about": [
        "r_stq"
      ]
    },
    {
      "id": "d_057",
      "from": 71,
      "to": 71,
      "text": "苏天晴心想：王道系是魔法少女们面对强敌逐渐成长，然后喊着友情和羁绊冲上去把反派干碎的那种故事；就算反派有系统有任务也很难在王道系故事里把主角干碎。",
      "channel": "thought",
      "mode": "assertion",
      "holder": "r_stq",
      "about": [
        "r_stq"
      ]
    },
    {
      "id": "d_058",
      "from": 72,
      "to": 72,
      "text": "苏天晴心想：我还能有反悔的机会吗？能不能把我送回原来的身体里？我觉得急性心肌梗死还有抢救的机会——",
      "channel": "thought",
      "mode": "question",
      "holder": "r_stq",
      "about": [
        "r_stq",
        "r_original_body"
      ]
    },
    {
      "id": "d_059",
      "from": 73,
      "to": 73,
      "text": "墨丘利秘典绑定成功。",
      "channel": "in-world-system",
      "mode": "assertion",
      "holder": "r_moqiu",
      "about": [
        "r_moqiu",
        "r_stq"
      ]
    },
    {
      "id": "d_060",
      "from": 74,
      "to": 74,
      "text": "脑子里响起的声音让苏天晴欲哭无泪。",
      "channel": "narrator",
      "mode": "assertion",
      "holder": null,
      "about": [
        "r_stq"
      ]
    },
    {
      "id": "d_061",
      "from": 75,
      "to": 75,
      "text": "契约成立。",
      "channel": "in-world-system",
      "mode": "assertion",
      "holder": "r_moqiu",
      "about": [
        "r_stq",
        "r_moqiu"
      ]
    },
    {
      "id": "d_062",
      "from": 76,
      "to": 76,
      "text": "走上反派魔法少女的道路吧，苏天晴。",
      "channel": "in-world-system",
      "mode": "request",
      "holder": "r_moqiu",
      "about": [
        "r_stq"
      ]
    }
  ],
