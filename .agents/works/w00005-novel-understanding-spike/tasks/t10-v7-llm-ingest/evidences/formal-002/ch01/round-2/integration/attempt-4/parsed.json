  "summaries": [
    {
      "id": "sum_su",
      "entity": "e_su",
      "facet": "本章经历与决定",
      "items": [
        {
          "text": "苏天晴（连续三个夜班下班后在街边面摊吃面的上班族）回忆起自己胸口一疼、眼前一黑昏死过去，醒来后她认为（本人判断）自己重生成了镜中的金毛狐女。",
          "refs": [
            "f_faint",
            "f_rebirth",
            "d6",
            "d11"
          ]
        },
        {
          "text": "她声称“取之不尽的财富”与“变成萝莉”是世界上最通用的两个愿望，并称变成萝莉本身就是最大奖励，随后不假思索地同意与墨丘利秘典签订契约。",
          "refs": [
            "f_su_wishes",
            "f_su_agree"
          ]
        },
        {
          "text": "她听到古书称造物主为她定制了成为反派魔法少女的一整套任务后感到后悔，认为王道故事中的反派难敌主角，想反悔并回到原来的身体；她也曾怀疑契约会不会是什么奇怪的奴隶契约。",
          "refs": [
            "f_creator_tasks",
            "f_su_regret",
            "d33"
