{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "types": ["node", "bun"]
  },
  "include": ["*.ts", "experiments/verify-published.ts", "experiments/profile-published.ts", "experiments/record-patch/*.ts"]
}
